{% extends 'layout/base.html.twig' %}
{% set body_class = 'app-body' %}
{% set title = 'Logowanie' %}

{% block stylesheets %}
    <link href="/assets/css/front.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="lt-login">
    <section class="lt-login-art">
        <div class="d-flex align-items-center gap-3 position-relative" style="z-index:1">
            {% include 'app/_emblem.html.twig' with {class: 'lt-brand-mark'} %}
            <div>
                <div class="lt-brand-name">LAW TRANSPORT</div>
                <div class="lt-brand-sub">{{ unit.nazwa|default('Grupa transportowa') }}</div>
            </div>
        </div>
        <div class="position-relative" style="z-index:1">
            <h1 class="mb-3">Każdy wyjazd zaplanowany, każdy kilometr rozliczony.</h1>
            <p class="mb-0">Planowanie wyjazdów, przydział pojazdów i kierowców, karty drogowe i rozliczenie paliwa dla floty wojskowej i cywilnej w jednym miejscu.</p>
        </div>
        <div class="lt-login-features">
            <div><i class="bi bi-calendar3-range"></i>Planer z przeciąganiem wyjazdów, pojazdów i kierowców</div>
            <div><i class="bi bi-file-earmark-text"></i>Rozkaz wyjazdu i karta drogowa gotowe do druku</div>
            <div><i class="bi bi-alarm"></i>Przypomnienia o przeglądach, badaniach i uprawnieniach</div>
        </div>
    </section>
    <section class="lt-login-form">
        <form method="post" action="/logowanie" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="next" value="{{ next }}">
            <h2 class="fw-bold mb-1">Zaloguj się</h2>
            <p class="text-muted mb-4">Użyj adresu e-mail i hasła nadanego przez administratora.</p>
            {% if error %}
                <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-1"></i>{{ error }}</div>
            {% endif %}
            <div class="mb-3">
                <label class="form-label fw-semibold" for="email">E-mail</label>
                <input type="email" class="form-control" id="email" name="email" value="{{ email }}" autocomplete="username" required autofocus>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold" for="password">Hasło</label>
                <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Zaloguj <i class="bi bi-arrow-right ms-1"></i></button>
            <p class="text-muted small mt-4 mb-0"><i class="bi bi-shield-lock me-1"></i>System do użytku służbowego. Logowania są rejestrowane.</p>
        </form>
    </section>
</div>
{% endblock %}
