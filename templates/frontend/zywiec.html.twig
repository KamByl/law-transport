{% extends 'layout/base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="/media/css/zywiec.css?v=1.14">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
    {% set rules = lotteryRulesContent|default({}) %}
    {% set rulesFileLink = rules.formularz_regulamin_plik|default('') %}
    {% set rulesExcerptImage = rules.formularz_regulamin_zdjecie|default('') %}
    {% set footerLinks = rules.stopka_linki|default([]) %}
    {% set formBottomText = rules.formularz_tekst_dol|default('') %}
    {% set defaultFormBottomText %}Twoje dane osobowe są przetwarzane w celach realizacji loterii promocyjnej "Z ŻABKI AŻ NA BACKSTAGE". Administratorem danych jest Nofsza Sp. z o.o. z siedzibą w Gdańsku, ul. Szafarnia 11/F8, 80-755 Gdańsk. Więcej informacji na temat przetwarzania danych znajdziesz <a href="#">TU</a>.{% endset %}
    {% set normalizedFormBottomText = formBottomText|striptags|replace({'&nbsp;': ' ', ' ': ' '})|trim %}
    {% set displayedFormBottomText = normalizedFormBottomText is not empty ? formBottomText : defaultFormBottomText %}
    {% set formData = formData|default(lotteryFormData|default({})) %}
    {% set productAllocation = productAllocationSettings|default({enabled: true, promoted: 5, other: 1, daily_limit: 4}) %}
    {% set lotterySubmission = lotterySubmission|default(null) %}
    {% set submittedWithoutScratchcard = lotterySubmission and lotterySubmission.scratchcards_enabled is defined and not lotterySubmission.scratchcards_enabled %}
    {% set scratchState = {scratchcards_enabled: lotterySubmission.scratchcards_enabled|default(false), scratch_token: lotterySubmission.scratch_token|default(''), scratch_link: lotterySubmission.scratch_link|default(''), ticket_entries: lotterySubmission.scratchcards_enabled|default(false) ? lotterySubmission.ticket_entries|default([]) : [], message: lotterySubmission.message|default('')} %}
    {% set recaptchaEnabled = recaptchaConfig.enabled|default(false) %}
    {% set recaptchaSiteKey = recaptchaConfig.site_key|default('') %}
    {% set recaptchaUseEnterprise = recaptchaConfig.use_enterprise|default(false) %}
    {% set isWinnerFormPage = submissionTemplate is defined and registrationTitle|default('') == 'Formularz zwycięzcy' %}
    {% set registrationAnchor = isWinnerFormPage ? 'zglos' : 'formularz' %}

    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" href="#start" aria-label="Żabka - strona główna"><img src="/media/img/logo-zabka.png" alt="Żabka"></a>
            <button class="nav-toggle" type="button" aria-label="Otwórz menu" aria-expanded="false"><span></span><span></span><span></span></button>
            <nav class="site-nav" aria-label="Menu główne">
                <a href="#zasady">Zasady</a>
                <a href="#produkty">Produkty promocyjne</a>
                <a href="#nagrody">Nagrody</a>
                <a href="#laureaci">Laureaci</a>
                <a href="#faq">FAQ</a>
                <a href="#kontakt">Kontakt</a>
                <a class="button blue" href="/loteria#formularz">Weź udział</a>
            </nav>
        </div>
    </header>

    <main id="start">
        <section class="hero">
            <div class="container hero-grid">
                <div class="hero-copy">
                    <div class="campaign-mark">
                        <img src="/media/img/home-text.png" alt="Wygraj gotówkę i bony do żabka">
                    </div>
                    <div class="hero-buttons">
                        <a class="button" href="#{{ registrationAnchor }}">Loteria</a>
                    </div>
                </div>
                <div class="hero-visual hero-main-visual" aria-hidden="true">
                    <img class="shirt" src="/media/img/home_page_image.png" alt="">
                    <h4>www.przedluzenielata.pl</h4>
                    <h5>Zakup promocyjni i zgłoszenia do loterii 09.09-22.09.2026 r.</h5>
                </div>
            </div>
        </section>

        <section class="section zasady" id="zasady">
            <div class="green-band-top-one"></div>
            <div class="container">
                <h1 class="section-title">Zasady promocji</h1>
                <div class="rules-grid">
                    <article class="rule-card">
                        <span class="rule-number number-one"></span>
                        <div class="rule-image"><img src="{{ rules.zdjecie_1|default('') is not empty ? rules.zdjecie_1 : '/media/img/rules-products.png' }}" alt="Produkty Żywiec"></div>
                        <p>{{ rules.opis_loteria_1|default('alkoholowe lub bezalkoholowe, w dowolnym wariancie, butelce lub puszce o dowolnej objętości.')|nl2br }}</p>
                    </article>
                    <article class="rule-card">
                        <span class="rule-number number-two"></span>
                        <div class="rule-image"><img src="{{ rules.zdjecie_2|default('') is not empty ? rules.zdjecie_2 : '/media/img/rules-app.png' }}" alt="Aplikacja Żappka"></div>
                        <p>{{ rules.opis_loteria_2|default('Pamiętaj, aby podczas zakupów użyć aktualnej wersji aplikacji Żappka.')|nl2br }}</p>
                    </article>
                    <article class="rule-card">
                        <span class="rule-number number-three"></span>
                        <div class="rule-image"><img src="{{ rules.zdjecie_3|default('') is not empty ? rules.zdjecie_3 : '/media/img/rules-code.png' }}" alt="Kod loteryjny w aplikacji"></div>
                        <p>{{ rules.opis_loteria_3|default('Po zakupie łącznie 4 produktów promocyjnych odbierz swój unikalny kod w aplikacji Żappka.')|nl2br }}</p>
                    </article>
                    <article class="rule-card">
                        <span class="rule-number number-four"></span>
                        <div class="rule-image"><img src="{{ rules.zdjecie_4|default('') is not empty ? rules.zdjecie_4 : '/media/img/rules-phone.png' }}" alt="Formularz zgłoszeniowy"></div>
                        <p>{{ rules.opis_loteria_4|default('Zgłoś kod na stronie loterii i sprawdź, czy nagroda jest Twoja.')|nl2br }}</p>
                    </article>
                </div>
                <p class="rules-note">{{ rules.informacje|default('*Produkty możesz kupić podczas jednej lub kilku transakcji. **Kod jest ważny i upoważnia do zgłoszenia się do loterii najpóźniej do 28.07.2026 roku.')|nl2br }}</p>
            </div>
            <div class="green-band-bottom-one"></div>
        </section>

        <section class="section products" id="produkty">
            <div class="container">
                <div class="text">
                    <h2 class="section-title">Produkty objęte <br>promocją</h2>
                    <p class="section-subtitle">dowolny wariant i objętość</p>
                </div>
                <div class="product-carousel" data-product-carousel>
                    <div class="product-viewport">
                        <div class="product-row" data-product-track aria-label="Produkty promocyjne">
                            {% set products = rules.produkty|default([]) %}
                            {% if products is not empty %}
                                {% for product in products %}
                                    <img src="{{ product.zdjecie|default('') }}" alt="Żywiec">
                                {% endfor %}
                            {% else %}
                                {% for i in 1..18 %}
                                    <img src="/media/img/piwo-{{ i }}.png" alt="Żywiec">
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section prize-section" id="nagrody">
            {# <div class="green-band-top-two"></div> #}
            <div class="container">
                <h2 class="section-title">Nagrody</h2>
            </div>
        </section>

        <section class="section form-section" id="{{ registrationAnchor }}">
            <div class="container">
                <div class="form-panel">
                    {% if not isWinnerFormPage %}
                        <div class="scratch-queue" data-scratch-queue data-scratch-state="{{ scratchState|json_encode|e('html_attr') }}"{% if not lotterySubmission or submittedWithoutScratchcard %} hidden{% endif %}>
                            <h2 data-scratch-heading>{{ lotterySubmission.message|default('Dziękujemy! Twoje zgłoszenie zostało przyjęte.') }}</h2>
                            <p data-scratch-count role="status">E-zdrapki do odkrycia: {{ scratchState.ticket_entries|length }}.</p>
                            <p class="error" data-scratch-error role="alert" hidden></p>
                            <button class="button wide" type="button" data-open-scratch{% if scratchState.ticket_entries is empty %} hidden{% endif %}>ODKRYJ E-ZDRAPKĘ</button>
                            <p><a data-scratch-link href="{{ scratchState.scratch_link }}"{% if not scratchState.scratch_link %} hidden{% endif %}>Wróć do swoich e-zdrapek</a></p>
                        </div>
                    {% endif %}
                    {% if isWinnerFormPage %}
                        <div class="form-fields">
                            <h2>{{ registrationTitle|default('Formularz zwycięzcy') }}</h2>
                            {% if registrationInfo|default('') is not empty %}
                                <p class="form-info">{{ registrationInfo }}</p>
                            {% endif %}
                        </div>
                        {% include submissionTemplate %}
                    {% elseif currentLottery %}
                        <form method="post" action="/loteria/losowane-zdrapki" enctype="multipart/form-data" id="promo-form" class="form-layout" data-cms-lottery-form data-daily-product-limit="{{ productAllocation.daily_limit }}" data-recaptcha-sitekey="{{ recaptchaEnabled ? recaptchaSiteKey : '' }}" data-recaptcha-use-enterprise="{{ recaptchaUseEnterprise ? '1' : '0' }}" novalidate>
                            <input type="hidden" name="lottery_form_token" value="{{ lotteryFormToken|default('') }}">
                            <input type="hidden" name="email_domain_warning_ack" value="{{ formData.email_domain_warning_ack|default('') }}">
                            <div class="form-fields">
                                <h2>Formularz rejestracyjny</h2>
                                {% for error in lotteryErrors|default([]) %}
                                    <p class="error" role="alert">{{ error }}</p>
                                {% endfor %}
                                <span class="error" data-error-for="lottery" role="alert"></span>
                                <p class="form-submit-success" data-lottery-submit-success{% if not submittedWithoutScratchcard %} hidden{% endif %}>Dziękujemy! Twoje zgłoszenie zostało zapisane.</p>
                                <div class="field">
                                    <label for="sellerCode">Kod z aplikacji Żappka</label>
                                    <input id="sellerCode" name="seller_code" value="{{ formData.seller_code|default('') }}" placeholder="Wpisz kod" required>
                                    <span class="error" data-error-for="seller_code"></span>
                                </div>
                                <div class="field">
                                    <label for="phone">Numer telefonu komórkowego</label>
                                    <input id="phone" name="phone" type="tel" inputmode="numeric" value="{{ formData.phone|default('') }}" placeholder="+48 ___ - ___ - ___" maxlength="19" autocomplete="tel" required data-phone-mask>
                                    <span class="error" data-error-for="phone"></span>
                                </div>
                                <div class="field">
                                    <label for="email">Adres e-mail</label>
                                    <input id="email" name="email" type="email" value="{{ formData.email|default('') }}" placeholder="adres@email.pl" required>
                                    <span class="error" data-error-for="email"></span>
                                </div>
                                <div class="field">
                                    <label for="purchaseDocumentNumber">Numer dowodu zakupu promocyjnego</label>
                                    <input id="purchaseDocumentNumber" name="purchase_document_number" value="{{ formData.purchase_document_number|default('') }}" maxlength="255" required>
                                    <span class="error" data-error-for="purchase_document_number"></span>
                                </div>
                                <div class="field">
                                    <label for="promotedProductsCount">Liczba produktów promowanych</label>
                                    <input id="promotedProductsCount" name="promoted_products_count" type="number" inputmode="numeric" min="0" max="2147483647" step="1" value="{{ formData.promoted_products_count is defined ? formData.promoted_products_count : '' }}" required>
                                    <span class="error" data-error-for="promoted_products_count"></span>
                                </div>
                                <div class="field">
                                    <label for="otherProductsCount">Liczba pozostałych produktów</label>
                                    <input id="otherProductsCount" name="other_products_count" type="number" inputmode="numeric" min="0" max="2147483647" step="1" value="{{ formData.other_products_count is defined ? formData.other_products_count : '' }}" required>
                                    <span class="error" data-error-for="other_products_count"></span>
                                </div>
                                <div class="form-info">
                                    {% if productAllocation.enabled %}
                                        Za każdy produkt promowany: {{ productAllocation.promoted }} losów lub e-zdrapek. Za każdy pozostały produkt: {{ productAllocation.other }} losów lub e-zdrapek.
                                    {% endif %}
                                    {% if productAllocation.daily_limit > 0 %}
                                        Dziennie do naliczenia uwzględniamy maksymalnie {{ productAllocation.daily_limit }} produktów łącznie, najpierw promowanych, następnie pozostałych. Możesz podać wszystkie zakupione produkty.
                                    {% endif %}
                                </div>
                                <div class="field">
                                    <label for="storeChain">Sieć sklepu</label>
                                    <select id="storeChain" name="store_chain" required>
                                        <option value="">Wybierz sieć sklepu</option>
                                        {% for chain in storeChains|default([]) %}
                                            <option value="{{ chain.id }}"{% if formData.store_chain|default('') == chain.id %} selected{% endif %}>{{ chain.name }}</option>
                                        {% endfor %}
                                    </select>
                                    <span class="error" data-error-for="store_chain"></span>
                                </div>
                                <div class="field">
                                    <label for="storeNip">NIP sklepu z dowodu zakupu</label>
                                    <input id="storeNip" name="store_nip" inputmode="numeric" maxlength="13" value="{{ formData.store_nip|default('') }}" placeholder="0000000000" required>
                                    <span class="error" data-error-for="store_nip"></span>
                                </div>
                                <div class="field">
                                    <label for="purchaseReceipt">Zdjęcie lub skan dowodu zakupu promocyjnego</label>
                                    <input id="purchaseReceipt" name="purchase_receipt" type="file" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" aria-describedby="purchaseReceiptHelp" required>
                                    <small id="purchaseReceiptHelp">Wgraj cały dowód zakupu z numerem zgodnym z podanym powyżej. Format: JPG, PNG lub PDF. Maksymalny rozmiar: 15 MB.</small>
                                    <span class="error" data-error-for="purchase_receipt"></span>
                                </div>
                                <div class="checks">
                                    <label class="check"><input type="checkbox" name="not_excluded" value="yes" required {% if formData.not_excluded|default('') == 'yes' %}checked{% endif %}><span>Potwierdzam, że mam ukończone 18 lat, posiadam pełną zdolność do czynności prawnych, zamieszkuję na terenie Polski, jestem konsumentem w rozumieniu art. 22¹ Kodeksu cywilnego oraz nie należę do grona osób wyłączonych z Loterii wskazanych w § 2 pkt 4 Regulaminu.{% if rulesExcerptImage is not empty %}<span class="rules-excerpt-wrap"><button class="rules-excerpt-trigger" type="button" data-rules-excerpt aria-label="Pokaż wyciąg z regulaminu" aria-expanded="false">i</button><span class="rules-excerpt-popover" role="dialog" aria-label="Wyciąg z regulaminu"><img src="{{ rulesExcerptImage }}" alt="Wyciąg z regulaminu"></span></span>{% endif %}</span></label>
                                    <span class="error" data-error-for="not_excluded"></span>
                                    <label class="check"><input type="checkbox" name="rules_accepted" value="yes" required {% if formData.rules_accepted|default('') == 'yes' %}checked{% endif %}><span>Potwierdzam zapoznanie się z {% if rulesFileLink is not empty %}<a href="{{ rulesFileLink }}" target="_blank" rel="noopener">Regulaminem Loterii</a>{% else %}Regulaminem Loterii{% endif %} oraz akceptuję jego postanowienia.</span></label>
                                    <span class="error" data-error-for="rules_accepted"></span>
                                </div>
                                <div class="form-info">{{ displayedFormBottomText|raw }}</div>
                                {% if recaptchaEnabled and recaptchaSiteKey %}
                                    <input type="hidden" name="g-recaptcha-response" value="">
                                    <span class="error" data-error-for="recaptcha"></span>
                                {% endif %}
                            </div>
                            <button class="button wide" type="submit">Wyślij</button>
                        </form>
                    {% elseif upcomingLottery and upcomingLottery.start_date|default('') is not empty %}
                        <div class="period-message period-message--upcoming" role="status">
                            <span class="period-message__eyebrow">Loteria jeszcze się nie zaczęła</span>
                            <h2>Startujemy już {{ upcomingLottery.start_date|date('d.m.Y') }} o {{ upcomingLottery.start_date|date('H:i') }}</h2>
                            <p>Formularz zgłoszeniowy będzie dostępny w czasie trwania loterii. Wróć do nas w terminie promocji i zgłoś swój kod.</p>
                        </div>
                    {% elseif endedLottery and endedLottery.end_date|default('') is not empty %}
                        <div class="period-message period-message--ended" role="status">
                            <span class="period-message__eyebrow">Loteria została zakończona</span>
                            <h2>Dziękujemy za udział!</h2>
                            <p>Przyjmowanie zgłoszeń zakończyło się {{ endedLottery.end_date|date('d.m.Y') }} o {{ endedLottery.end_date|date('H:i') }}. Zapraszamy do śledzenia wyników i kolejnych akcji.</p>
                        </div>
                    {% else %}
                        <div class="period-message period-message--ended" role="status">
                            <span class="period-message__eyebrow">Formularz jest niedostępny</span>
                            <h2>Brak aktywnej loterii</h2>
                            <p>W tym momencie nie prowadzimy przyjmowania zgłoszeń. Sprawdź stronę ponownie później.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        <section class="section winners" id="laureaci">
            <div class="green-band-top-three"></div>
            <div class="container">
                <h2 class="section-title">Laureaci</h2>
                <form class="winners-search" data-winners-search role="search">
                    <label class="winners-search__label" for="winning-code-search">Sprawdź, czy Twój kod jest zwycięski</label>
                    <div class="winners-search__row">
                        <div class="winners-search__input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                            <input id="winning-code-search" type="search" placeholder="Wpisz zwycięski kod" maxlength="128" autocomplete="off" autocapitalize="characters" spellcheck="false" data-winners-search-input>
                        </div>
                        <button class="winners-search__button" type="submit" data-winners-search-submit>Wyszukaj</button>
                    </div>
                    <p class="winners-search__feedback" data-winners-search-feedback aria-live="polite" hidden></p>
                </form>
                <table class="winners-table{% if hasMoreWinners|default(false) %} winners-table--with-more{% endif %}" data-winners-list data-winners-endpoint="/loteria/wyniki" data-winners-offset="{{ latestWinners|default([])|length }}" data-winners-page-size="10">
                    <thead><tr><th>Nagroda</th><th>Zwycięski kod</th></tr></thead>
                    <tbody data-winners-body>
                        {% for winner in latestWinners|default([]) %}
                            <tr>
                                <td class="winner-prize">
                                    {% if winner.prizeImage|default('') is not empty %}
                                        <img class="winner-prize__image" src="{{ winner.prizeImage }}" alt="{{ winner.prizeLabel|default('Nagroda') }}">
                                    {% else %}
                                        <span>{{ winner.prizeLabel|default('Nagroda') }}</span>
                                    {% endif %}
                                </td>
                                <td class="winner-code">{{ winner.winningCode|default('') is not empty ? winner.winningCode : '—' }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="2">Lista laureatów zostanie opublikowana po pierwszych rozstrzygnięciach.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if hasMoreWinners|default(false) %}
                    <div class="winners-more">
                        <button class="button wide" type="button" data-winners-load-more>Pokaż więcej</button>
                    </div>
                {% endif %}
            </div>
            <div class="green-band-bottom-three"></div>
        </section>

        <section class="section faq-section" id="faq">
            <div class="container">
                <h2 class="section-title">Najczęściej zadawane pytania</h2>
                <div class="faq-list" data-faq-list data-faq-visible-count="5">
                    {% set displayedFaq = faqEntries|default([]) %}
                    {% if displayedFaq is empty %}
                        {% set displayedFaq = [
                            {question: 'Co należy zrobić, żeby wziąć udział w loterii?', answer: 'Kup produkt promocyjny w Żabce, odbierz kod w aplikacji Żappka i zarejestruj go w formularzu.'},
                            {question: 'Kto może wziąć udział w loterii?', answer: 'W promocji mogą brać udział osoby pełnoletnie, które spełniają warunki regulaminu.'},
                            {question: 'Ile razy można zgłosić udział?', answer: 'Każdy unikalny kod może zostać użyty tylko jeden raz.'},
                            {question: 'Jak sprawdzę, czy wygrałem?', answer: 'Po przyjęciu zgłoszenia naciśnij „ODKRYJ E-ZDRAPKĘ”. Wynik zostanie ustalony w momencie kliknięcia. Odsłoń pole zdrapki, aby go zobaczyć. Kolejne zdrapki oraz link do nich znajdziesz również w wiadomości e-mail.'},
                            {question: 'Jakie nagrody są przewidziane?', answer: 'Do wygrania są bilety, koszulki, kody na piwo oraz bony do Żabki.'}
                        ] %}
                    {% endif %}
                    {% for faqEntry in displayedFaq %}
                        <article class="faq-item"{% if loop.index > 5 %} hidden{% endif %}>
                            <button class="faq-question" aria-expanded="false">{{ faqEntry.question|default('Pytanie') }}</button>
                            <div class="faq-answer">{{ faqEntry.answer|default('')|raw }}</div>
                        </article>
                    {% endfor %}
                </div>
                {% if displayedFaq|length > 5 %}
                    <div class="faq-more"><button class="button wide" type="button" data-faq-toggle aria-expanded="false">Zobacz więcej pytań</button></div>
                {% endif %}
            </div>
        </section>
    </main>

    <footer class="site-footer" id="kontakt">
        <div class="green-band-top-four"></div>
        <div class="container">
            <div class="footer-top">
                <div class="campaign-mark footer-mark"><img src="/media/img/logo-bottom.png" alt="Żabka"></div>
                <div class="footer-column"><h3>{{ rules.stopka_naglowek_1|default('Organizator promocji') }}</h3><p>{{ rules.stopka_tresc_1|default('Nofsza Sp. z o.o.<br>ul. Szafarnia 11/F8<br>80-755 Gdańsk<br><a href="https://www.nofsza.pl">www.nofsza.pl</a><br><a href="mailto:bok@nofsza.pl">bok@nofsza.pl</a>')|raw }}</p></div>
                <div class="footer-column"><h3>{{ rules.stopka_naglowek_2|default('Kontakt') }}</h3><p>{{ rules.stopka_tresc_2|default('Infolinia (58) 573 12 21<br>Koszt połączenia wg taryfy operatora.<br>Infolinia jest czynna w dni robocze od pon. do pt. (10.00-16.00)')|raw }}</p></div>
            </div>
            <div class="responsible"><img src="/media/img/responsible.png" alt="Tylko dla osób pełnoletnich. Nie prowadź po alkoholu."><strong>Pij odpowiedzialnie.</strong></div>
            <p class="footer-disclaimer">Jeżeli uważasz, że reklama naszego produktu narusza zasady Kodeksu Rady Etyki Reklamy, <a href="https://radareklamy.pl/formularz-skargi/">kliknij</a>.<br>Nasze materiały przeznaczone są dla osób powyżej 18 roku życia i nie należy ich przekazywać ani udostępniać osobom poniżej 18 lat.</p>
            <div class="footer-bottom">
                <span>© Nofsza 2026. Wszystkie prawa zastrzeżone.</span>
                <div class="footer-links">
                    {% for footerLink in footerLinks %}
                        {% if footerLink.link|default('') is not empty and footerLink.nazwa|default('') is not empty %}
                            <a href="{{ footerLink.link }}">{{ footerLink.nazwa }}</a>
                        {% endif %}
                    {% else %}
                        <a href="{{ rulesFileLink is not empty ? rulesFileLink : '#' }}">Regulamin</a><a href="#">Polityka prywatności</a><a href="#">Kodeks postępowania</a>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="beer"></div>
    </footer>

    <div class="scratch-backdrop" data-scratch-modal aria-hidden="true">
        <section class="scratch-modal" role="dialog" aria-modal="true" aria-labelledby="scratch-title">
            <button class="scratch-close" type="button" data-close-scratch aria-label="Zamknij e-zdrapkę" aria-hidden="true" disabled>x</button>
            <div class="scratch-layout">
                <div class="scratch-content">
                    <p class="scratch-kicker">TWOJA E-ZDRAPKA</p>
                    <h2 class="scratch-title" id="scratch-title">Zdrap 1 pole e-zdrapki i sprawdź, czy nagroda jest Twoja.</h2>
                    <div class="scratch-grid" aria-label="Pola e-zdrapki">
                        {% for i in 1..9 %}
                            <button class="scratch-cell" type="button" aria-label="Zdrap pole {{ i }}">
                                <span class="scratch-reveal">
                                    <img class="scratch-cap-base" src="/media/img/kapsel-zdrapany.png" alt="">
                                    <img class="scratch-prize-img" src="/media/img/prize-gdansk.png" alt="Nagroda" style="display: none">
                                    <img class="scratch-no-win" src="/media/img/brak-wygranej.png" alt="Brak wygranej" style="display: none">
                                </span>
                                <img class="scratch-cover" src="/media/img/kapsel.png" alt="">
                            </button>
                        {% endfor %}
                    </div>
                    <p class="scratch-hint">Jeżeli po odsłonięciu pola e-zdrapki widoczny będzie symbol Nagrody natychmiastowej, oznacza to wygraną w Loterii.</p>
                    <div data-scratch-outcome hidden>
                        <p class="scratch-result" data-scratch-result role="status"></p>
                        <p data-scratch-remaining></p>
                        <p class="error" data-scratch-error role="alert" hidden></p>
                        <button class="button wide" type="button" data-next-scratch hidden>ODKRYJ KOLEJNĄ E-ZDRAPKĘ</button>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {% if recaptchaEnabled and recaptchaSiteKey %}
        {% if recaptchaUseEnterprise %}
            <script src="https://www.google.com/recaptcha/enterprise.js?render={{ recaptchaSiteKey }}" async defer></script>
        {% else %}
            <script src="https://www.google.com/recaptcha/api.js?render={{ recaptchaSiteKey }}" async defer></script>
        {% endif %}
    {% endif %}
    <script src="/media/js/zywiec.js?v=2.8"></script>
{% endblock %}
