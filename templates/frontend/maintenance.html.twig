<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title|default('Strona w budowie') }}</title>
    <link href="/assets/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<section class="min-vh-100 d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5 text-center">
                        {% if logoPath|default('')|trim is not empty %}
                            <img class="img-fluid mb-4" src="{{ logoPath }}" alt="Logo" style="max-height: 110px;">
                        {% else %}
                            {% include 'frontend/_cms_brand.html.twig' %}
                        {% endif %}
                        <h1 class="h3 mb-3">Strona jest w trakcie budowy</h1>
                        <p class="text-muted mb-0">
                            Przepraszamy, obecnie prowadzimy prace serwisowe. Wróć proszę za jakiś czas.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</body>
</html>
