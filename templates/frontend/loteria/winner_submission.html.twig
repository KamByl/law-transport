{% if status == 'success' and message %}
    <div class="registration-form winner-submission-message" role="status">
        <p class="winner-submission-message__text text-success">{{ message }}</p>
    </div>
{% elseif status == 'error' and message %}
    <div class="alert alert-danger mt-4" role="alert">{{ message }}</div>
{% endif %}

{% if errors is not empty %}
    <div class="alert alert-danger mt-4" role="alert">
        <ul class="mb-0">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

{% if status != 'success' %}
    <form method="post" class="registration-form winner-form" enctype="multipart/form-data" novalidate data-winner-form>
        <h3 class="field field-full">Weryfikacja wygranej</h3>
        <div class="field">
            <label for="winner-email">Adres e-mail</label>
            <input type="email" id="winner-email" value="{{ formData.email|default('') }}" readonly aria-readonly="true">
        </div>

        <div class="field">
            <label for="winner-phone">Numer telefonu komórkowego</label>
            <input type="text" id="winner-phone" value="{{ formData.telefon|default('') }}" readonly aria-readonly="true">
        </div>

        <div class="field field-full">
            <label for="winner-receipt">Dowód zakupu (zdjęcie)*</label>
            <label class="dropzone purchase-receipt-dropzone" for="winner-receipt">
                <span class="purchase-receipt-dropzone__placeholder">Upuść plik lub <strong>kliknij, aby przesłać</strong><small>jpg, png - max 15 MB</small></span>
            </label>
            <input type="file" class="visually-hidden" id="winner-receipt" name="rachunek" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required>
            <span class="error" data-error-for="rachunek"></span>
        </div>

        <div class="field field-full">
            <div class="info-black">* Pola obowiązkowe</div>
            <div class="info-dane">Dodaj czytelne zdjęcie dowodu zakupu, abyśmy mogli zweryfikować Twoją wygraną.</div>
        </div>

        <div class="field field-full">
            <span class="error" data-winner-form-validation role="alert"></span>
        </div>

        <div class="field field-full winner-submit">
            <button type="submit" class="button wide" data-winner-form-submit>WYŚLIJ</button>
        </div>

        <div class="field field-full winner-loading d-none" data-winner-form-loading aria-live="polite" aria-hidden="true">
            <span class="winner-spinner" aria-hidden="true"></span>
            <span>Wczytujemy dane, prosimy o chwilę cierpliwości…</span>
        </div>
    </form>
{% endif %}
