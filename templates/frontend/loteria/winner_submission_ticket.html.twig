{% if status == 'success' and message %}
    <div class="registration-form winner-submission-message" role="status">
        <p class="winner-submission-message__text text-success">{{ message }}</p>
    </div>
{% elseif status == 'error' and message %}
    <div class="alert alert-danger mt-4" role="alert">{{ message }}</div>
{% endif %}

{% if errors is not empty %}
    <div class="alert alert-danger mt-4" role="alert">
        <ul class="mb-0">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

{% set isBankAccountWithTax = winnerFormType|default('') == 'bank_account_with_tax' %}
{% set isBankAccountWithoutTax = winnerFormType|default('') == 'bank_account_without_tax' %}
{% set isBankAccountForm = isBankAccountWithTax or isBankAccountWithoutTax %}

{% if status != 'success' %}
    <form method="post" class="registration-form winner-form" novalidate data-winner-form {% if ticketRequiresReceipt|default(false) %}enctype="multipart/form-data"{% endif %}>
        <h3 class="field field-full">Dane zwycięzcy</h3>
        <div class="field">
            <label for="winner-first-name">Imię*</label>
            <input type="text" id="winner-first-name" name="imie" value="{{ formData.imie|default('') }}" required>
            <span class="error" data-error-for="imie"></span>
        </div>

        <div class="field">
            <label for="winner-last-name">Nazwisko*</label>
            <input type="text" id="winner-last-name" name="nazwisko" value="{{ formData.nazwisko|default('') }}" required>
            <span class="error" data-error-for="nazwisko"></span>
        </div>

        {% if not isBankAccountForm %}
            <div class="field">
                <label for="winner-email">Adres e-mail</label>
                <input type="email" id="winner-email" value="{{ formData.email|default('') }}" readonly aria-readonly="true">
            </div>

            <div class="field">
                <label for="winner-phone">Numer telefonu komórkowego</label>
                <input type="text" id="winner-phone" value="{{ formData.telefon|default('') }}" readonly aria-readonly="true">
            </div>
        {% endif %}

        {% if not winnerOnlyNameSurname|default(false) %}
        {% if isBankAccountWithTax %}
            <h3 class="field field-full">Adres zamieszkania</h3>
        {% endif %}
        <div class="field">
            <label for="winner-street">Ulica*</label>
            <input type="text" id="winner-street" name="ulica" value="{{ formData.ulica|default('') }}" required>
            <span class="error" data-error-for="ulica"></span>
        </div>

        <div class="field">
            <label for="winner-house-number">{{ isBankAccountWithTax ? 'Numer domu/lokalu*' : 'Numer domu*' }}</label>
            <input type="text" id="winner-house-number" name="numer_domu" value="{{ formData.numer_domu|default('') }}" required>
            <span class="error" data-error-for="numer_domu"></span>
        </div>

        {% if not isBankAccountWithTax %}
        <div class="field">
            <label for="winner-apartment-number">Numer mieszkania</label>
            <input type="text" id="winner-apartment-number" name="numer_mieszkania" value="{{ formData.numer_mieszkania|default('') }}">
            <span class="error" data-error-for="numer_mieszkania"></span>
        </div>
        {% endif %}

        <div class="field">
            <label for="winner-postal-code">Kod pocztowy*</label>
            <input type="text" id="winner-postal-code" name="kod_pocztowy" value="{{ formData.kod_pocztowy|default('') }}" required>
            <span class="error" data-error-for="kod_pocztowy"></span>
        </div>

        <div class="field">
            <label for="winner-city">Miejscowość*</label>
            <input type="text" id="winner-city" name="miejscowosc" value="{{ formData.miejscowosc|default('') }}" required>
            <span class="error" data-error-for="miejscowosc"></span>
        </div>

        {% if winnerRequiresShirtSize|default(false) %}
        <div class="field">
            <label for="winner-shirt-size">Rozmiar koszulki*</label>
            <select id="winner-shirt-size" name="rozmiar_koszulki" required>
                <option value="">Wybierz rozmiar</option>
                {% for shirtSize in ['S', 'M', 'L', 'XL'] %}
                    <option value="{{ shirtSize }}"{% if formData.rozmiar_koszulki|default('') == shirtSize %} selected{% endif %}>{{ shirtSize }}</option>
                {% endfor %}
            </select>
            <span class="error" data-error-for="rozmiar_koszulki"></span>
        </div>
        {% endif %}

        {% if winnerRequiresPesel is not defined or winnerRequiresPesel %}
        <div class="field field-full">
            <label for="winner-pesel">Numer PESEL*</label>
            <input type="text" id="winner-pesel" name="numer_pesel" value="{{ formData.numer_pesel|default('') }}" inputmode="numeric" maxlength="11">
            <span class="error" data-error-for="numer_pesel"></span>
        </div>

        {% if not isBankAccountWithTax %}
            <div class="field">
                <label for="winner-document-type">Rodzaj dokumentu*</label>
                <input type="text" id="winner-document-type" name="rodzaj_dokumentu" value="{{ formData.rodzaj_dokumentu|default('') }}" required>
                <span class="error" data-error-for="rodzaj_dokumentu"></span>
            </div>
        {% endif %}

        <div class="field">
            <label for="winner-document">Seria i numer dokumentu tożsamości*</label>
            <input type="text" id="winner-document" name="seria_i_numer_dokumentu_tozsamosci" value="{{ formData.seria_i_numer_dokumentu_tozsamosci|default('') }}" required>
            <span class="error" data-error-for="seria_i_numer_dokumentu_tozsamosci"></span>
        </div>

        <div class="field field-full">
            <div class="winner-check">
                <input
                    type="checkbox"
                    id="winner-no-pesel"
                    name="brak_pesel"
                    value="1"
                    data-winner-no-pesel-toggle
                    {% if formData.brak_pesel|default('') == '1' %}checked{% endif %}
                >
                <label for="winner-no-pesel">
                    Nie posiadam numeru PESEL
                </label>
            </div>
        </div>

        <div class="field d-none" data-winner-no-pesel-field>
            <label for="winner-birth-date">Data urodzenia (gdy brak PESEL)*</label>
            <input type="date" id="winner-birth-date" name="data_urodzenia" value="{{ formData.data_urodzenia|default('') }}">
            <span class="error" data-error-for="data_urodzenia"></span>
        </div>

        <div class="field d-none" data-winner-no-pesel-field>
            <label for="winner-citizenship">Obywatelstwo (gdy brak PESEL)*</label>
            <input type="text" id="winner-citizenship" name="obywatelstwo" value="{{ formData.obywatelstwo|default('') }}">
            <span class="error" data-error-for="obywatelstwo"></span>
        </div>

        {% if ticketRequiresReceipt|default(false) %}
            <div class="field field-full">
                <label for="winner-receipt">Zdjęcie paragonu*</label>
                <label class="dropzone purchase-receipt-dropzone" for="winner-receipt">
                    <span class="purchase-receipt-dropzone__placeholder">Upuść plik lub <strong>kliknij, aby przesłać</strong><small>jpg, png - max 15 MB</small></span>
                </label>
                <input type="file" class="visually-hidden" id="winner-receipt" name="rachunek" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required>
                <span class="error" data-error-for="rachunek"></span>
            </div>
        {% endif %}

        {% endif %}

        {% endif %}

        {% if isBankAccountForm %}
            <div class="field field-full">
                <label for="winner-bank-account">{{ isBankAccountWithoutTax ? 'Numer rachunku bankowego prowadzonego w PLN*' : 'Numer rachunku bankowego*' }}</label>
                <input type="text" id="winner-bank-account" name="numer_rachunku_bankowego" value="{{ formData.numer_rachunku_bankowego|default('') }}" inputmode="numeric" maxlength="32" autocomplete="off" required>
                <span class="error" data-error-for="numer_rachunku_bankowego"></span>
            </div>
        {% endif %}

        <div class="field field-full">
            <div class="info-black">* Pola obowiązkowe</div>
            {% if winnerRequiresPesel is not defined or winnerRequiresPesel %}
                <div class="info-dane">Jeżeli nie posiadasz numeru PESEL, podaj datę urodzenia i obywatelstwo.</div>
            {% endif %}
        </div>

        <div class="field field-full">
            <span class="error" data-winner-form-validation role="alert"></span>
        </div>

        <div class="field field-full winner-submit">
            <button type="submit" class="button wide" data-winner-form-submit>WYŚLIJ</button>
        </div>

        <div class="field field-full winner-loading d-none" data-winner-form-loading aria-live="polite" aria-hidden="true">
            <span class="winner-spinner" aria-hidden="true"></span>
            <span>Wczytujemy dane, prosimy o chwilę cierpliwości…</span>
        </div>
    </form>
{% endif %}
