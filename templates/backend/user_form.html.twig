{% extends 'layout/backend.html.twig' %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">{{ title }}</h1>
        <p class="text-muted mb-0">Uzupełnij dane użytkownika.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/cms/users">Wróć</a>
</div>

<div class="card p-4">
    {% if errors is not empty %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
    <form method="post">
        {% include 'backend/_csrf_token.html.twig' %}
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Imię</label>
                <input class="form-control" type="text" name="first_name" value="{{ formUser.firstName|default('') }}" required>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Nazwisko</label>
                <input class="form-control" type="text" name="last_name" value="{{ formUser.lastName|default('') }}" required>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" type="email" name="email" value="{{ formUser.email|default('') }}" required>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Telefon</label>
                <input class="form-control" type="text" name="phone" value="{{ formUser.phone|default('') }}">
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Hasło{% if not requirePassword %} (pozostaw puste, aby nie zmieniać){% endif %}</label>
                <input class="form-control" type="password" name="password" {% if requirePassword %}required{% endif %}>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>
                <select class="form-select" name="active">
                    <option value="1" {% if formUser.active|default(true) %}selected{% endif %}>Aktywny</option>
                    <option value="0" {% if formUser.active is defined and not formUser.active %}selected{% endif %}>Nieaktywny</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label d-block">Przelogowanie</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="can_impersonate" id="user-can-impersonate" {% if formUser.canImpersonate|default(false) %}checked{% endif %}>
                    <label class="form-check-label" for="user-can-impersonate">Pozwól temu użytkownikowi przelogowywać się na innych</label>
                </div>
                <div class="form-text">Opcja nadaje uprawnienie do przelogowania na dowolnego innego użytkownika.</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Grupa</label>
                <select class="form-select" name="group_id">
                    {% for group in groups %}
                        <option value="{{ group.id }}" {% if group.id == selectedGroupId %}selected{% endif %}>{{ group.name }}</option>
                    {% endfor %}
                </select>
                <div class="form-text">Wybierz jedną grupę dla użytkownika.</div>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Indywidualne uprawnienia</label>
            <input class="form-control mb-2" type="search" id="user-permission-search" placeholder="Szukaj uprawnień po nazwie lub kodzie">
            <div class="border rounded p-2" style="max-height: 240px; overflow-y: auto;">
                {% if permissions is not empty %}
                    {% for permission in permissions %}
                        {% set optionLabel = permission.label ~ ' (' ~ permission.code ~ ')' %}
                        {% set actionState = permissionActions[permission.id]|default({}) %}
                        <div class="user-permission-option" data-search="{{ optionLabel|lower }}">
                            <div class="fw-semibold">{{ optionLabel }}</div>
                            <div class="d-flex flex-wrap gap-3 mt-1{% if not loop.last %} border-bottom pb-2 mb-2{% endif %}">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permission_actions[{{ permission.id }}][view]" id="user-permission-{{ permission.id }}-view"{% if actionState.view|default(false) %} checked{% endif %}>
                                    <label class="form-check-label" for="user-permission-{{ permission.id }}-view">Podgląd</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permission_actions[{{ permission.id }}][create]" id="user-permission-{{ permission.id }}-create"{% if actionState.create|default(false) %} checked{% endif %}>
                                    <label class="form-check-label" for="user-permission-{{ permission.id }}-create">Dodawanie</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permission_actions[{{ permission.id }}][edit]" id="user-permission-{{ permission.id }}-edit"{% if actionState.edit|default(false) %} checked{% endif %}>
                                    <label class="form-check-label" for="user-permission-{{ permission.id }}-edit">Edycja</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permission_actions[{{ permission.id }}][delete]" id="user-permission-{{ permission.id }}-delete"{% if actionState.delete|default(false) %} checked{% endif %}>
                                    <label class="form-check-label" for="user-permission-{{ permission.id }}-delete">Usuwanie</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permission_actions[{{ permission.id }}][stats]" id="user-permission-{{ permission.id }}-stats"{% if actionState.stats|default(false) %} checked{% endif %}>
                                    <label class="form-check-label" for="user-permission-{{ permission.id }}-stats">Statystyki</label>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="text-muted">Brak zdefiniowanych uprawnień.</div>
                {% endif %}
            </div>
            <div class="form-text">Zaznacz czynności, które mają być nadane bezpośrednio użytkownikowi.</div>
        </div>
        <button class="btn btn-primary" type="submit">Zapisz</button>
    </form>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const searchInput = document.getElementById('user-permission-search');
            if (!searchInput) {
                return;
            }

            const options = Array.from(document.querySelectorAll('.user-permission-option'));
            const normalize = (value) => (value || '').toLowerCase();

            const applyFilter = () => {
                const term = normalize(searchInput.value.trim());
                options.forEach((option) => {
                    const haystack = option.dataset.search || '';
                    option.classList.toggle('d-none', term.length > 0 && !haystack.includes(term));
                });
            };

            searchInput.addEventListener('input', applyFilter);
        })();
    </script>
{% endblock %}
