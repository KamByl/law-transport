<script>
(() => {
    const fileInput = document.getElementById('csv-import-file');
    const wrap = document.getElementById('csv-import-mapping-wrap');
    const container = document.getElementById('csv-import-mapping-table');
    if (!fileInput || !wrap || !container) return;
    const fields = {{ importableFields|default([])|json_encode|raw }};
    const mappingInput = document.getElementById('csv-import-mapping');
    const defaultsInput = document.getElementById('csv-import-defaults');

    const parseCsvLine = (line, delimiter) => {
        const values = [];
        let current = '';
        let inQuotes = false;

        for (let i = 0; i < line.length; i += 1) {
            const char = line[i];

            if (char === '"') {
                if (inQuotes && line[i + 1] === '"') {
                    current += '"';
                    i += 1;
                } else {
                    inQuotes = !inQuotes;
                }
                continue;
            }

            if (char === delimiter && !inQuotes) {
                values.push(current);
                current = '';
                continue;
            }

            current += char;
        }

        values.push(current);
        return values;
    };

    const countDelimiterOutsideQuotes = (line, delimiter) => {
        let count = 0;
        let inQuotes = false;
        for (let i = 0; i < line.length; i += 1) {
            const char = line[i];
            if (char === '"') {
                if (inQuotes && line[i + 1] === '"') {
                    i += 1;
                    continue;
                }
                inQuotes = !inQuotes;
                continue;
            }
            if (char === delimiter && !inQuotes) {
                count += 1;
            }
        }
        return count;
    };

    fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        const text = await file.text();
        const headerLine = (text.split(/\r?\n/).find((line) => line.trim() !== '') || '');
        const semicolonCount = countDelimiterOutsideQuotes(headerLine, ';');
        const commaCount = countDelimiterOutsideQuotes(headerLine, ',');
        const delimiter = semicolonCount >= commaCount ? ';' : ',';
        const headers = parseCsvLine(headerLine, delimiter)
            .map((item, index) => {
                const normalized = item.replace(/^﻿/, '').trim();
                return index === 0 ? normalized.replace(/^ï»¿/, '') : normalized;
            })
            .filter((item) => item !== '');
        const rows = fields.map((field) => {
            const options = ['<option value="">-- nie mapuj --</option>', ...headers.map((header) => `<option value="${header}">${header}</option>`)].join('');
            return `<tr><td>${field.label || field.name}</td><td><select class="form-select form-select-sm" data-map="${field.name}">${options}</select></td><td><input class="form-control form-control-sm" type="text" data-default="${field.name}" placeholder="Wartość domyślna"></td></tr>`;
        }).join('');
        container.innerHTML = `<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Pole systemowe</th><th>Kolumna CSV</th><th>Stała wartość</th></tr></thead><tbody>${rows}</tbody></table></div>`;
        wrap.classList.remove('d-none');
    });
    document.getElementById('csv-import-form')?.addEventListener('submit', () => {
        const mapping = {};
        const defaults = {};
        container.querySelectorAll('[data-map]').forEach((el) => mapping[el.dataset.map] = el.value);
        container.querySelectorAll('[data-default]').forEach((el) => defaults[el.dataset.default] = el.value);
        mappingInput.value = JSON.stringify(mapping);
        defaultsInput.value = JSON.stringify(defaults);
    });
})();
</script>
{% if manualSort and canEdit %}
    <script>
        (() => {
            const table = document.querySelector('table[data-reorder-url]');
            const tableBody = document.querySelector('[data-sortable-body]');
            const status = document.querySelector('[data-sort-status]');
            if (!table || !tableBody) {
                return;
            }

            let draggingRow = null;

            const setStatus = (message, tone = 'muted') => {
                if (!status) {
                    return;
                }
                status.textContent = message;
                status.classList.remove('text-muted', 'text-danger', 'text-success');
                status.classList.add(`text-${tone}`);
            };

            const getIds = () => Array.from(tableBody.querySelectorAll('tr[data-sort-id]'))
                .map((row) => Number.parseInt(row.dataset.sortId || '', 10))
                .filter(Number.isFinite);

            const saveOrder = async () => {
                const ids = getIds();
                if (!ids.length) {
                    return;
                }
                setStatus('Zapisywanie kolejności...', 'muted');
                try {
                    const response = await fetch(table.dataset.reorderUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'X-CSRF-Token': adminCsrfToken,
                        },
                        body: JSON.stringify({ ids }),
                    });
                    if (!response.ok) {
                        throw new Error('Request failed');
                    }
                    setStatus('Kolejność zapisana.', 'success');
                } catch (error) {
                    setStatus('Nie udało się zapisać kolejności. Spróbuj ponownie.', 'danger');
                }
            };

            tableBody.addEventListener('dragstart', (event) => {
                const handle = event.target.closest('.drag-handle');
                if (!handle) {
                    event.preventDefault();
                    return;
                }
                const row = handle.closest('tr[data-sort-id]');
                if (!row) {
                    return;
                }
                draggingRow = row;
                row.classList.add('is-dragging');
                event.dataTransfer.effectAllowed = 'move';
                event.dataTransfer.setData('text/plain', row.dataset.sortId || '');
            });

            tableBody.addEventListener('dragover', (event) => {
                if (!draggingRow) {
                    return;
                }
                event.preventDefault();
                const targetRow = event.target.closest('tr[data-sort-id]');
                if (!targetRow || targetRow === draggingRow) {
                    return;
                }
                const rect = targetRow.getBoundingClientRect();
                const shouldInsertAfter = event.clientY - rect.top > rect.height / 2;
                tableBody.insertBefore(draggingRow, shouldInsertAfter ? targetRow.nextSibling : targetRow);
            });

            tableBody.addEventListener('dragend', () => {
                if (!draggingRow) {
                    return;
                }
                draggingRow.classList.remove('is-dragging');
                draggingRow = null;
            });

            tableBody.addEventListener('drop', (event) => {
                if (!draggingRow) {
                    return;
                }
                event.preventDefault();
                saveOrder();
            });
        })();
    </script>
