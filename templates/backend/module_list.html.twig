    function handleModuleDeleteSubmit(form) {
        if (!confirm('Czy na pewno chcesz usunąć ten wpis?')) {
            return false;
        }

        const relatedInput = form.querySelector('[data-delete-related-input="true"]');
        if (relatedInput) {
            relatedInput.value = '0';
        }

        const deleteRelatedConfirm = {{ module.list.delete_related_confirm|default('')|json_encode|raw }};
        if (deleteRelatedConfirm) {
            const shouldDeleteRelated = confirm(deleteRelatedConfirm);
            if (relatedInput) {
                relatedInput.value = shouldDeleteRelated ? '1' : '0';
            }
        }

        return true;
    }

</script>

