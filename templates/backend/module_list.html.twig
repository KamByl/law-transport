<script>
    document.addEventListener('DOMContentLoaded', () => {
        const openButton = document.querySelector('[data-columns-settings-open]');
        const modalElement = document.querySelector('[data-columns-settings-modal]');
        const list = document.querySelector('[data-columns-settings-list]');
        const columnsInput = document.querySelector('[data-columns-input]');
        const columnsOrderInput = document.querySelector('[data-columns-order-input]');
        const columnsLabelsInput = document.querySelector('[data-columns-labels-input]');
        const filtersInput = document.querySelector('[data-filters-input]');
        const filterLabelsInput = document.querySelector('[data-filter-labels-input]');
        const filtersList = document.querySelector('[data-filters-settings-list]');
        if (!openButton || !modalElement || !list || !columnsInput || !columnsOrderInput || !columnsLabelsInput || !filtersInput || !filterLabelsInput || !filtersList || typeof bootstrap === 'undefined') return;
        const modal = new bootstrap.Modal(modalElement);
        let draggingItem = null;
        let draggingFilterItem = null;
        const serialize = () => {
            const items = Array.from(list.querySelectorAll('[data-column-item]'));
            return {
                order: items.map((item) => item.dataset.columnItem).filter(Boolean),
                selected: items.filter((item) => item.querySelector('input')?.checked).map((item) => item.dataset.columnItem).filter(Boolean),
            };
        };
        openButton.addEventListener('click', () => modal.show());
        list.addEventListener('click', (event) => {
            const item = event.target.closest('[data-column-item]');
            if (!item) return;
            if (event.target.closest('[data-edit-label]')) {
                const checkbox = item.querySelector('input[type="checkbox"]');
                const labelElement = item.querySelector('[data-column-label]');
                if (!checkbox || !labelElement) return;
                const currentLabel = labelElement.textContent?.trim() || '';
                const nextLabel = window.prompt('Podaj nazwę kolumny:', currentLabel);
                if (nextLabel === null) return;
                const normalizedLabel = nextLabel.trim();
                if (normalizedLabel !== '') labelElement.textContent = normalizedLabel;
                return;
            }
            if (event.target.closest('[data-move-up]') && item.previousElementSibling) item.parentNode.insertBefore(item, item.previousElementSibling);
            if (event.target.closest('[data-move-down]') && item.nextElementSibling) item.parentNode.insertBefore(item.nextElementSibling, item);
        });
        list.addEventListener('dragstart', (event) => { draggingItem = event.target.closest('[data-column-item]'); });
        list.addEventListener('dragover', (event) => {
            if (!draggingItem) return;
            event.preventDefault();
            const target = event.target.closest('[data-column-item]');
            if (!target || target === draggingItem) return;
            const rect = target.getBoundingClientRect();
            list.insertBefore(draggingItem, event.clientY > rect.top + rect.height / 2 ? target.nextSibling : target);
        });
        list.addEventListener('dragend', () => { draggingItem = null; });
        filtersList.addEventListener('click', (event) => {
            const item = event.target.closest('[data-filter-item]');
            if (!item) return;
            if (event.target.closest('[data-edit-filter-label]')) {
                const labelElement = item.querySelector('[data-filter-label]');
                if (!labelElement) return;
                const currentLabel = labelElement.textContent?.trim() || '';
                const nextLabel = window.prompt('Podaj nazwę filtra:', currentLabel);
                if (nextLabel === null) return;
                const normalizedLabel = nextLabel.trim();
                if (normalizedLabel !== '') labelElement.textContent = normalizedLabel;
                return;
            }
            if (event.target.closest('[data-filter-move-up]') && item.previousElementSibling) item.parentNode.insertBefore(item, item.previousElementSibling);
            if (event.target.closest('[data-filter-move-down]') && item.nextElementSibling) item.parentNode.insertBefore(item.nextElementSibling, item);
        });
        filtersList.addEventListener('dragstart', (event) => { draggingFilterItem = event.target.closest('[data-filter-item]'); });
        filtersList.addEventListener('dragover', (event) => {
            if (!draggingFilterItem) return;
            event.preventDefault();
            const target = event.target.closest('[data-filter-item]');
            if (!target || target === draggingFilterItem) return;
            const rect = target.getBoundingClientRect();
            filtersList.insertBefore(draggingFilterItem, event.clientY > rect.top + rect.height / 2 ? target.nextSibling : target);
        });
        filtersList.addEventListener('dragend', () => { draggingFilterItem = null; });
        const defaultColumns = {{ defaultColumns|json_encode|raw }};
        const defaultColumnLabels = {{ defaultColumnLabels|json_encode|raw }};
        const defaultFilterLabels = {{ defaultFilterLabels|json_encode|raw }};
        document.querySelector('[data-columns-settings-reset]')?.addEventListener('click', () => {
            list.querySelectorAll('input[type="checkbox"]').forEach((input) => {
                input.checked = defaultColumns.includes(input.value);
            });
            const itemsByColumn = new Map(Array.from(list.querySelectorAll('[data-column-item]')).map((item) => [item.dataset.columnItem, item]));
            const fragment = document.createDocumentFragment();
            defaultColumns.forEach((column) => {
                const item = itemsByColumn.get(column);
                if (item) {
                    fragment.appendChild(item);
                    itemsByColumn.delete(column);
                }
            });
            itemsByColumn.forEach((item) => fragment.appendChild(item));
            list.appendChild(fragment);
            list.querySelectorAll('[data-column-item]').forEach((item) => {
                const columnName = item.dataset.columnItem;
                const labelElement = item.querySelector('[data-column-label]');
                if (!columnName || !labelElement) return;
                const fallbackLabel = columnName
                    .split('_')
                    .filter((part) => part !== '')
                    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
                    .join(' ');
                labelElement.textContent = (defaultColumnLabels[columnName] || '').trim() || fallbackLabel;
            });
            const defaultFilters = {{ defaultActiveFilterNames|default(activeFilterNames)|json_encode|raw }};
            const defaultFilterOrder = {{ availableFilterNames|json_encode|raw }};
            const filterItemsByName = new Map(Array.from(filtersList.querySelectorAll('[data-filter-item]')).map((item) => [item.dataset.filterItem, item]));
            const filterFragment = document.createDocumentFragment();
            defaultFilterOrder.forEach((filterName) => {
                const item = filterItemsByName.get(filterName);
                if (item) {
                    filterFragment.appendChild(item);
                    filterItemsByName.delete(filterName);
                }
            });
            filterItemsByName.forEach((item) => filterFragment.appendChild(item));
            filtersList.appendChild(filterFragment);
            filtersList.querySelectorAll('input[type="checkbox"]').forEach((input) => {
                input.checked = defaultFilters.includes(input.value);
            });
            filtersList.querySelectorAll('[data-filter-item]').forEach((item) => {
                const filterName = item.dataset.filterItem;
                const labelElement = item.querySelector('[data-filter-label]');
                if (!filterName || !labelElement) return;
                const fallbackLabel = filterName
                    .split('_')
                    .filter((part) => part !== '')
                    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
                    .join(' ');
                labelElement.textContent = (defaultFilterLabels[filterName] || '').trim() || fallbackLabel;
            });
        });
        document.querySelector('[data-columns-settings-apply]')?.addEventListener('click', () => {
            const data = serialize();
            columnsInput.value = data.selected.join(',');
            columnsOrderInput.value = data.order.join(',');
            const labels = {};
            list.querySelectorAll('[data-column-item]').forEach((item) => {
                const columnName = item.dataset.columnItem;
                const labelElement = item.querySelector('[data-column-label]');
                if (!columnName || !labelElement) return;
                labels[columnName] = (labelElement.textContent || '').trim();
            });
            columnsLabelsInput.value = JSON.stringify(labels);
            const selectedFilters = Array.from(filtersList.querySelectorAll('input[type="checkbox"]:checked')).map((input) => input.value);
            filtersInput.value = selectedFilters.join(',');
            const filterLabels = {};
            filtersList.querySelectorAll('[data-filter-item]').forEach((item) => {
                const filterName = item.dataset.filterItem;
                const labelElement = item.querySelector('[data-filter-label]');
                if (!filterName || !labelElement) return;
                filterLabels[filterName] = (labelElement.textContent || '').trim();
            });
            filterLabelsInput.value = JSON.stringify(filterLabels);
            columnsInput.form?.submit();
        });
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.querySelector('[data-bulk-actions-form]');
        const selectAll = document.querySelector('[data-bulk-select-all]');
        const itemCheckboxes = Array.from(document.querySelectorAll('[data-bulk-item]'));
        const panel = document.querySelector('[data-bulk-actions-panel]');
        const selectedCount = document.querySelector('[data-bulk-selected-count]');
        const deleteButton = document.querySelector('[data-bulk-delete-button]');
        const exportSelectedIdsInput = document.querySelector('[data-export-selected-ids]');
        const exportSubmitButton = document.querySelector('[data-export-submit-button]');

        if (!form || !selectAll || itemCheckboxes.length === 0 || !panel || !selectedCount || !deleteButton) return;

        const refreshState = () => {
            const checkedItems = itemCheckboxes.filter((input) => input.checked);
            const checkedCount = checkedItems.length;
            selectedCount.textContent = String(checkedCount);
            panel.classList.toggle('d-none', checkedCount === 0);
            deleteButton.disabled = checkedCount === 0;
            selectAll.checked = checkedCount > 0 && checkedCount === itemCheckboxes.length;
            selectAll.indeterminate = checkedCount > 0 && checkedCount < itemCheckboxes.length;
            if (exportSelectedIdsInput) {
                exportSelectedIdsInput.value = checkedItems.map((input) => input.value).join(',');
            }
            if (exportSubmitButton) {
                exportSubmitButton.textContent = checkedCount > 0 ? 'Pobierz zaznaczone' : 'Pobierz';
            }
        };

        selectAll.addEventListener('change', () => {
            itemCheckboxes.forEach((input) => {
                input.checked = selectAll.checked;
            });
            refreshState();
        });

        itemCheckboxes.forEach((input) => {
            input.addEventListener('change', refreshState);
        });

        refreshState();
    });
</script>
