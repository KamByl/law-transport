{% extends 'layout/backend.html.twig' %}

{% block content %}
{% set canCreate = permissionService.can(user, 'groups', 'create') %}
{% set canEdit = permissionService.can(user, 'groups', 'edit') %}
{% set canDelete = permissionService.can(user, 'groups', 'delete') %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Grupy użytkowników</h1>
        <p class="text-muted mb-0">Zarządzaj grupami oraz przypisanymi uprawnieniami.</p>
    </div>
    {% if canCreate %}
        <a class="btn btn-primary" href="/cms/groups/create">Dodaj grupę</a>
    {% endif %}
</div>

<div class="card p-4">
    <form class="row g-2 align-items-center mb-3" method="get" action="/cms/groups">
        <div class="col-sm-6 col-md-4">
            <input class="form-control" type="search" name="q" value="{{ query }}" placeholder="Szukaj grupy">
        </div>
        <input type="hidden" name="sort" value="{{ sort }}">
        <input type="hidden" name="dir" value="{{ dir }}">
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">Szukaj</button>
        </div>
        {% if query %}
            <div class="col-auto">
                <a class="btn btn-outline-secondary" href="/cms/groups">Wyczyść</a>
            </div>
        {% endif %}
    </form>

    {% set queryPrefix = query ? ('?q=' ~ query|url_encode ~ '&') : '?' %}
    {% set idDir = sort == 'id' and dir == 'asc' ? 'desc' : 'asc' %}
    {% set nameDir = sort == 'name' and dir == 'asc' ? 'desc' : 'asc' %}
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>
                    <a href="{{ queryPrefix }}sort=id&dir={{ idDir }}" class="text-decoration-none">
                        ID{% if sort == 'id' %} {{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                    </a>
                </th>
                <th>
                    <a href="{{ queryPrefix }}sort=name&dir={{ nameDir }}" class="text-decoration-none">
                        Nazwa{% if sort == 'name' %} {{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                    </a>
                </th>
                <th class="text-end">Akcje</th>
            </tr>
        </thead>
        <tbody>
            {% for group in groups %}
                <tr>
                    <td>{{ group.id }}</td>
                    <td>{{ group.name }}</td>
                    <td class="text-end">
                        {% if canEdit %}
                            <a class="btn btn-sm btn-outline-primary" href="/cms/groups/{{ group.id }}/edit">Edytuj</a>
                        {% endif %}
                        {% if canDelete %}
                            <form method="post" action="/cms/groups/{{ group.id }}/delete" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć tę grupę?');">
                                {% include 'backend/_csrf_token.html.twig' %}
                                <button class="btn btn-sm btn-outline-danger" type="submit">Usuń</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center text-muted">Brak grup do wyświetlenia.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
