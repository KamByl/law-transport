{% extends 'layout/backend.html.twig' %}

{% block content %}
    {% set columnLabels = {
        'id': 'ID',
        'email': 'E-mail',
        'phone': 'Telefon',
        'purchase_document_number': 'Numer dowodu zakupu',
        'purchase_amount': 'Kwota zakupu',
        'seller_code': 'Kod sprzedawcy',
        'submitted_at': 'Data zgłoszenia',
        'ticket_id': 'ID losu',
        'prize_name': 'Nazwa nagrody',
        'wygrany': 'Wygrany',
        'status': 'Status',
        'clicked_at': 'Data kliknięcia',
        'imie': 'Imię',
        'nazwisko': 'Nazwisko',
        'telefon': 'Telefon',
        'stan': 'Stan',
        'rodzaj': 'Rodzaj',
        'email_o_wygranej_wyslany_at': 'Data wysłania e-maila o wygranej',
        'seller_email': 'E-mail sprzedawcy',
        'recipient': 'Adresat',
        'subject': 'Temat',
        'success': 'Sukces',
        'error': 'Błąd',
        'context': 'Kontekst',
        'sent_at': 'Data wysłania',
        'sentAt': 'Data wysłania',
        'attempts': 'Liczba prób',
        'max_attempts': 'Maksymalna liczba prób',
        'last_error': 'Ostatni błąd',
        'created_at': 'Data utworzenia',
        'createdAt': 'Data utworzenia',
        'available_at': 'Dostępne od',
        'availableAt': 'Dostępne od'
    } %}
    {% set hiddenColumns = ['rachunek', 'lottery_type'] %}

<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h4 mb-1">Informacja o uczestniku</h1>
            <p class="text-muted mb-0">Wyszukaj po adresie e-mail i sprawdź wszystkie dane uczestnika w systemie.</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form class="row g-3" method="get" action="/cms/informacja-o-uczestniku">
                <div class="col-md-8 col-lg-6">
                    <label class="form-label">Adres e-mail</label>
                    <input type="email" name="email" class="form-control" value="{{ email }}" placeholder="np. jan.kowalski@example.com" required>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" type="submit">Szukaj</button>
                </div>
            </form>
        </div>
    </div>

    {% if email and results %}
        <div class="row g-4 mb-4">
            {% for section in results.sections %}
                <div class="col-sm-6 col-xl-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="text-muted small mb-1">{{ section.label }}</div>
                            <div class="display-6 fw-semibold">{{ section.count }}</div>
                            {% if section.latestDate %}
                                <div class="small text-muted mt-2">Ostatnia data: {{ section.latestDate }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% for section in results.sections %}
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h6 mb-3">{{ section.label }} ({{ section.count }})</h2>
                    {% if section.rows is not empty %}
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead>
                                    <tr>
                                        {% for column, _value in section.rows|first.values %}
                                            {% if column not in hiddenColumns %}
                                                <th>{{ columnLabels[column] ?? column }}</th>
                                            {% endif %}
                                        {% endfor %}
                                        <th class="text-end">Więcej</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in section.rows %}
                                        {% set isDrawAndScratchLottery = row.values.lottery_type|default('') == 'losowanie_zdrapki' %}
                                        <tr>
                                            {% for column, value in row.values %}
                                                {% if column not in hiddenColumns %}
                                                    <td>{{ value is same as(null) ? '-' : value }}</td>
                                                {% endif %}
                                            {% endfor %}
                                            <td class="text-end">
                                                {% if row.moreAction %}
                                                    <a class="btn btn-sm btn-outline-secondary" href="{{ row.moreAction.url }}">{{ row.moreAction.label }}</a>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                                {% if section.key == 'submissions' and row.moreAction and row.moreAction.label == 'Edytuj' and isDrawAndScratchLottery %}
                                                    <form method="post" action="/cms/modules/loteria_zgloszenia/{{ row.values.id }}/extra-action" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz ponownie wysłać e-mail z linkiem do zdrapek?');">
                                                        {% include 'backend/_csrf_token.html.twig' %}
                                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Wyślij ponownie link do zdrapek</button>
                                                    </form>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-muted">Brak danych dla tego adresu e-mail.</div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Inne dopasowania po e-mailu ({{ results.additionalMatchesCount }})</h2>
                {% if results.additionalMatches is not empty %}
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Tabela</th>
                                    <th>Kolumna</th>
                                    <th>Ilość rekordów</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for match in results.additionalMatches %}
                                    <tr>
                                        <td><code>{{ match.table }}</code></td>
                                        <td><code>{{ match.column }}</code></td>
                                        <td>{{ match.count }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-muted">Brak dodatkowych danych po tym adresie e-mail.</div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
