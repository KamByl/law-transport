{% extends 'layout/backend.html.twig' %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h4 mb-1">Logi SMS</h1>
            <p class="text-muted mb-0">Historia wysłanych wiadomości SMS.</p>
        </div>
        <form class="d-flex" method="get" action="/cms/sms-logs">
            <input type="text" name="q" class="form-control form-control-sm" placeholder="Szukaj po numerze, treści, kontekście" value="{{ query }}">
            <button class="btn btn-primary btn-sm ms-2" type="submit">Szukaj</button>
        </form>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Odbiorca</th>
                            <th>Użytkownik</th>
                            <th>Email</th>
                            <th>Kontekst</th>
                            <th>Status</th>
                            <th>Raport doręczenia</th>
                            <th>Błąd</th>
                            <th>IP</th>
                            <th>Treść</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td>{{ log.sentAt ? log.sentAt|date('Y-m-d H:i:s') : '' }}</td>
                                <td>{{ log.recipient }}</td>
                                <td>
                                    {% if log.user %}
                                        {{ log.user.firstName }} {{ log.user.lastName }}
                                    {% else %}
                                        <span class="text-muted">Nieznany</span>
                                    {% endif %}
                                </td>
                                <td>{{ log.email }}</td>
                                <td>{{ log.context ?: '-' }}</td>
                                <td>
                                    {% if log.success %}
                                        <span class="badge bg-success">OK</span>
                                    {% else %}
                                        <span class="badge bg-danger">Błąd</span>
                                    {% endif %}
                                </td>
                                <td class="small">
                                    {% if log.deliveryStatus %}
                                        <div><span class="badge bg-info text-dark">{{ log.deliveryStatus }}</span></div>
                                    {% else %}
                                        <div class="text-muted">Brak</div>
                                    {% endif %}
                                    {% if log.deliveredAt %}
                                        <div class="text-muted">{{ log.deliveredAt|date('Y-m-d H:i:s') }}</div>
                                    {% endif %}
                                    {% if log.smsapiId %}
                                        <div class="text-muted">ID: {{ log.smsapiId }}</div>
                                    {% endif %}
                                </td>
                                <td class="small text-muted">
                                    <div>{{ log.error|default('-') }}</div>
                                    {% if log.deliveryError %}
                                        <div>Raport: {{ log.deliveryError }}</div>
                                    {% endif %}
                                </td>
                                <td class="small text-muted">{{ log.ipAddress|default('') }}</td>
                                <td class="small text-muted">{{ log.message }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center text-muted">Brak logów do wyświetlenia.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
