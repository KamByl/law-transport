<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="send-winner-emails" name="send_winner_emails" value="1" {% if sendWinnerEmails|default(false) %}checked{% endif %}>
    <label class="form-check-label" for="send-winner-emails">Wyślij maile do zwycięzców od razu po dodaniu</label>
    <div class="form-text">System sprawdzi pole „Szablon maila wysyłany przy ustawieniu statusu” w początkowym statusie zwycięzcy i użyje wskazanego tam szablonu. Przy imporcie CSV przydzielanie kodów i przygotowanie maili odbywa się partiami przez CRON.</div>
</div>
<input type="hidden" name="confirm_winner_emails" value="0">
<script>
(() => {
    const form = document.currentScript.closest('form');
    const checkbox = form.querySelector('[name="send_winner_emails"]');
    const confirmation = form.querySelector('[name="confirm_winner_emails"]');
    checkbox.addEventListener('change', () => { confirmation.value = '0'; });
    form.addEventListener('submit', (event) => {
        confirmation.value = '0';
        if (event.defaultPrevented || !checkbox.checked) return;
        if (!window.confirm('Czy na pewno chcesz wysłać maile do zwycięzców od razu po ich dodaniu? System użyje ustawień wysyłki z początkowego statusu zwycięzcy.')) {
            event.preventDefault();
            return;
        }
        confirmation.value = '1';
    });
})();
</script>
