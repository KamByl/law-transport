{% extends 'layout/backend.html.twig' %}

{% block content %}
<h1 class="h3 mb-4">Instalacja bazy danych</h1>
<p class="text-muted">System tworzy brakujące tabele i kolumny, ale nie usuwa istniejących pól.</p>

{% if executedSql is empty %}
    <div class="alert alert-success">Brak zmian do wykonania. Schemat jest aktualny.</div>
{% else %}
    <div class="alert alert-info">Wykonano aktualizację schematu. Poniżej lista zapytań SQL:</div>
    <pre class="bg-light p-3 border rounded">{{ executedSql|join('\n') }}</pre>
{% endif %}
{% endblock %}
