{% if hasConditionalVisibility %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const wrappers = Array.from(document.querySelectorAll('[data-visible-if-field][data-visible-if-values]'));

            const getFieldElements = (fieldName) => {
                if (!fieldName) {
                    return [];
                }

                const escapedName = window.CSS && typeof window.CSS.escape === 'function'
                    ? window.CSS.escape(fieldName)
                    : fieldName.replace(/"/g, '\\"');

                return Array.from(document.querySelectorAll(`[name="${escapedName}"], [name="${escapedName}[]"]`));
            };

            const getSelectedValues = (fieldElements) => {
                const values = [];
                fieldElements.forEach((element) => {
                    if (element instanceof HTMLSelectElement && element.multiple) {
                        Array.from(element.selectedOptions).forEach((option) => values.push(option.value));
                        return;
                    }

                    if (element instanceof HTMLInputElement && ['checkbox', 'radio'].includes(element.type)) {
                        if (element.checked) {
                            values.push(element.value);
                        }
                        return;
                    }

                    values.push(element.value);
                });

                return values.filter((value) => value !== '');
            };

            const setWrapperEnabled = (wrapper, isVisible) => {
                wrapper.classList.toggle('d-none', !isVisible);
                wrapper.querySelectorAll('input, select, textarea, button').forEach((input) => {
                    if (isVisible) {
                        if (input.dataset.wasDisabledByVisibility === '1') {
                            input.disabled = false;
                            delete input.dataset.wasDisabledByVisibility;
                        }
                        return;
                    }

                    if (input.disabled) {
                        return;
                    }

                    input.disabled = true;
                    input.dataset.wasDisabledByVisibility = '1';
                });
            };

            const updateVisibility = () => {
                wrappers.forEach((wrapper) => {
                    const dependsField = wrapper.dataset.visibleIfField || '';
                    const dependsValuesRaw = wrapper.dataset.visibleIfValues || '[]';
                    let expectedValues = [];

                    try {
                        expectedValues = JSON.parse(dependsValuesRaw);
                    } catch (error) {
                        expectedValues = [];
                    }

                    const fieldElements = getFieldElements(dependsField);
                    const selectedValues = getSelectedValues(fieldElements);
                    const shouldShow = fieldElements.length > 0
                        && expectedValues.some((expectedValue) => selectedValues.includes(String(expectedValue)));

                    setWrapperEnabled(wrapper, shouldShow);
                });
            };

            const dependencyFields = new Set(
                wrappers.map((wrapper) => wrapper.dataset.visibleIfField || '').filter((fieldName) => fieldName !== '')
            );

            dependencyFields.forEach((fieldName) => {
                getFieldElements(fieldName).forEach((element) => {
                    element.addEventListener('change', updateVisibility);
                    element.addEventListener('input', updateVisibility);
                });
            });

            updateVisibility();
        });
    </script>
