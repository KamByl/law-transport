    </style>
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/super-build/ckeditor.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const editorFactory = window.CKEDITOR && window.CKEDITOR.ClassicEditor
                ? window.CKEDITOR.ClassicEditor
                : window.ClassicEditor;

            if (!editorFactory || typeof editorFactory.create !== 'function') {
                return;
            }

            const canBrowseFiles = {{ canBrowseFiles ? 'true' : 'false' }};
            const activeFileLinkEditors = new Map();

            const ensureFileLinkModal = () => {
                let modal = document.getElementById('ckeditor-file-link-modal');
                if (modal) {
                    return modal;
                }

                modal = document.createElement('div');
                modal.id = 'ckeditor-file-link-modal';
                modal.className = 'ckeditor-file-link-modal';
                modal.innerHTML = `
                    <div class="ckeditor-file-link-modal__backdrop" data-file-link-close="true"></div>
                    <div class="ckeditor-file-link-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ckeditor-file-link-title">
                        <div class="ckeditor-file-link-modal__header">
                            <div>
                                <h3 id="ckeditor-file-link-title" class="ckeditor-file-link-modal__title">Wstaw link do pliku</h3>
                                <p class="ckeditor-file-link-modal__subtitle">Wybierz plik z modułu Pliki i wstaw go do treści.</p>
                            </div>
                            <button type="button" class="btn-close" aria-label="Zamknij" data-file-link-close="true"></button>
                        </div>
                        <div class="ckeditor-file-link-modal__body">
                            <label class="form-label" for="ckeditor-file-link-select">Dostępne pliki</label>
                            <select id="ckeditor-file-link-select" class="form-select ckeditor-file-link-modal__select" size="12" data-file-link-select="true"></select>
                            <div class="d-flex justify-content-end mt-3">
                                <button type="button" class="btn btn-primary" data-file-link-insert="true">Wstaw wybrany plik</button>
                            </div>
                            <div class="small text-muted mt-2" data-file-link-status="true"></div>
                        </div>
                    </div>
                `;

                modal.addEventListener('click', (event) => {
                    if (event.target instanceof HTMLElement && event.target.dataset.fileLinkClose === 'true') {
                        modal.classList.remove('is-open');
                    }
                });

                const insertSelectedFileLink = (modal, editor) => {
                    const select = modal.querySelector('[data-file-link-select="true"]');
                    const status = modal.querySelector('[data-file-link-status="true"]');
                    if (!(select instanceof HTMLSelectElement) || !(status instanceof HTMLElement)) {
                        return;
                    }

                    const selectedOption = select.options[select.selectedIndex] || null;
                    if (!(selectedOption instanceof HTMLOptionElement) || selectedOption.value === '') {
                        status.textContent = 'Wybierz plik z listy, aby wstawić link.';
                        return;
                    }

                    const item = {
                        label: selectedOption.dataset.label || selectedOption.textContent || selectedOption.value,
                        originalName: selectedOption.dataset.originalName || '',
                        url: selectedOption.value,
                    };

                    const savedSelection = editor._fileLinkSelection || editor.model.document.selection;
                    editor.model.change((writer) => {
                        writer.setSelection(savedSelection);
                    });

                    const selection = editor.model.document.selection;
                    if (!selection.isCollapsed) {
                        editor.execute('link', item.url);
                    } else {
                        editor.model.change((writer) => {
                            const insertPosition = selection.getFirstPosition();
                            writer.insertText(item.label || item.originalName || item.url, { linkHref: item.url }, insertPosition);
                        });
                    }

                    modal.classList.remove('is-open');
                    editor.editing.view.focus();
                };

                const select = modal.querySelector('[data-file-link-select="true"]');
                const insertButton = modal.querySelector('[data-file-link-insert="true"]');
                if (select instanceof HTMLSelectElement) {
                    select.addEventListener('dblclick', () => {
                        const editorId = modal.dataset.editorId || '';
                        const editor = activeFileLinkEditors.get(editorId);
                        if (editor) {
                            insertSelectedFileLink(modal, editor);
                        }
                    });
                }
                if (insertButton instanceof HTMLButtonElement) {
                    insertButton.addEventListener('click', () => {
                        const editorId = modal.dataset.editorId || '';
                        const editor = activeFileLinkEditors.get(editorId);
                        if (editor) {
                            insertSelectedFileLink(modal, editor);
                        }
                    });
                }

                document.body.appendChild(modal);

                return modal;
            };

            const loadFileLinkResults = (modal) => {
                const select = modal.querySelector('[data-file-link-select="true"]');
                const status = modal.querySelector('[data-file-link-status="true"]');
                if (!(select instanceof HTMLSelectElement) || !(status instanceof HTMLElement)) {
                    return;
                }

                select.innerHTML = '';
                status.textContent = 'Ładowanie plików...';

                const url = new URL('/cms/modules/file-browser', window.location.origin);
                url.searchParams.set('limit', '500');

                fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(async (response) => {
                        if (!response.ok) {
                            if (response.status === 401 || response.status === 403) {
                                throw new Error('Brak uprawnień do podglądu plików.');
                            }

                            throw new Error('Nie udało się pobrać plików.');
                        }

                        try {
                            return await response.json();
                        } catch (error) {
                            throw new Error('Serwer zwrócił niepoprawną odpowiedź.');
                        }
                    })
                    .then((payload) => {
                        const items = Array.isArray(payload.items) ? payload.items : [];
                        if (!items.length) {
                            status.textContent = 'Brak dostępnych plików do wstawienia.';
                            return;
                        }

                        items.forEach((item) => {
                            const option = document.createElement('option');
                            option.value = item.url || '';
                            option.dataset.label = item.label || '';
                            option.dataset.originalName = item.originalName || '';
                            option.textContent = item.label || item.originalName || item.url || 'Bez nazwy';
                            if (item.originalName && item.originalName !== option.textContent) {
                                option.textContent += ` — ${item.originalName}`;
                            }
                            select.appendChild(option);
                        });

                        if (select.options.length > 0) {
                            select.selectedIndex = 0;
                        }

                        status.textContent = 'Wybierz plik z listy i kliknij „Wstaw wybrany plik”.';
                    })
                    .catch((error) => {
                        status.textContent = error instanceof Error ? error.message : 'Nie udało się pobrać listy plików.';
                    });
            };

            const openFileLinkModal = (editor) => {
                if (!canBrowseFiles) {
                    return;
                }

                const modal = ensureFileLinkModal();
                const select = modal.querySelector('[data-file-link-select="true"]');
                if (!(select instanceof HTMLSelectElement)) {
                    return;
                }

                editor._fileLinkSelection = editor.model.createSelection(editor.model.document.selection);
                const editorId = editor.id || `editor-${activeFileLinkEditors.size + 1}`;
                activeFileLinkEditors.set(editorId, editor);
                modal.dataset.editorId = editorId;
                modal.classList.add('is-open');
                loadFileLinkResults(modal);
                window.setTimeout(() => select.focus(), 0);
            };

            const mountFileLinkToolbarButton = (editor) => {
                if (!canBrowseFiles) {
                    return;
                }

                const toolbarElement = editor.ui.view.toolbar.element;
                if (!(toolbarElement instanceof HTMLElement) || toolbarElement.querySelector('[data-cke-file-link-button="true"]')) {
                    return;
                }

                const toolbarItems = toolbarElement.querySelector('.ck-toolbar__items');
                if (!(toolbarItems instanceof HTMLElement)) {
                    return;
                }

                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'ck ck-button ck-off';
                button.dataset.ckeFileLinkButton = 'true';
                button.title = 'Wstaw link do pliku';
                button.setAttribute('aria-label', 'Wstaw link do pliku');
                button.innerHTML = `
                    <span class="ck ck-icon ck-button__icon" aria-hidden="true">
                        <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15.5 17h-11A2.5 2.5 0 0 1 2 14.5v-9A2.5 2.5 0 0 1 4.5 3H10l5.5 5.5v6A2.5 2.5 0 0 1 15.5 17Zm-5-12.5H4.5A1.5 1.5 0 0 0 3 6v8.5A1.5 1.5 0 0 0 4.5 16h11a1.5 1.5 0 0 0 1.5-1.5V9h-4A2.5 2.5 0 0 1 10.5 6.5v-2Zm1 0V6.5A1.5 1.5 0 0 0 13 8h2.8l-4.3-4.3Z"/>
                            <path d="M6 11.5h8v1H6zm0 2.5h6v1H6z"/>
                        </svg>
                    </span>
                    <span class="ck ck-button__label">Plik</span>
                `;
                button.addEventListener('click', () => openFileLinkModal(editor));

                const insertAfterLinkButton = toolbarItems.querySelector('.ck-button[aria-label=\"Link\"], .ck-button[aria-label=\"Edytuj link\"]');
                if (insertAfterLinkButton && insertAfterLinkButton.parentNode === toolbarItems) {
                    insertAfterLinkButton.insertAdjacentElement('afterend', button);
                    return;
                }

                toolbarItems.appendChild(button);
            };

            document.querySelectorAll('textarea[data-wysiwyg="true"]').forEach((textarea) => {
                const isReadOnly = textarea.dataset.wysiwygReadonly === 'true';
                const toolbarItems = [
                    'sourceEditing',
                    '|',
                    'heading',
                    '|',
                    'bold',
                    'italic',
                    'underline',
                    'strikethrough',
                    '|',
                    'fontSize',
                    'fontColor',
                    'fontBackgroundColor',
                    '|',
                    'link',
                ];

                toolbarItems.push(
                    'bulletedList',
                    'numberedList',
                    '|',
                    'removeFormat',
                    '|',
                    'undo',
                    'redo',
                );

                editorFactory.create(textarea, {
                    removePlugins: [
                        'AIAssistant',
                        'CKBox',
                        'CKFinder',
                        'EasyImage',
                        'RealTimeCollaborativeComments',
                        'RealTimeCollaborativeTrackChanges',
                        'RealTimeCollaborativeRevisionHistory',
                        'PresenceList',
                        'Comments',
                        'TrackChanges',
                        'TrackChangesData',
                        'RevisionHistory',
                        'Pagination',
                        'WProofreader',
                        'MathType',
                        'SlashCommand',
                        'Template',
                        'DocumentOutline',
                        'FormatPainter',
                        'TableOfContents',
                        'PasteFromOfficeEnhanced',
                    ],
                    fontSize: {
                        options: [
                            10,
                            12,
                            14,
                            'default',
                            18,
                            20,
                            24,
                            28,
                            32,
                            36,
                        ],
                        supportAllValues: true,
                    },
                    toolbar: {
                        items: toolbarItems,
                        shouldNotGroupWhenFull: true,
                    },
                })
                    .then((editor) => {
                        mountFileLinkToolbarButton(editor);
                        if (isReadOnly) {
                            if (typeof editor.enableReadOnlyMode === 'function') {
                                editor.enableReadOnlyMode('wysiwyg');
                            } else {
                                editor.isReadOnly = true;
                            }
                        }
                    })
                    .catch((error) => {
                        console.error(error);
                    });
            });
        });
    </script>
