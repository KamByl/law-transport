{% extends 'layout/backend.html.twig' %}

{% set canBrowseFiles = permissionService.can(user, 'pliki', 'view') %}
{% set moduleViewConfig = module.view|default({}) %}
{% set plainReadOnlyView = readOnly|default(false) and moduleViewConfig.display_mode|default('form') == 'text' %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">{{ title }}</h1>
        <p class="text-muted mb-0">{{ plainReadOnlyView ? 'Podgląd danych wpisu.' : 'Uzupełnij dane wpisu.' }}</p>
    </div>
    <div class="d-flex gap-2">
        {% if showWinnerEmailOption|default(false) %}
            <a class="btn btn-outline-primary" href="/cms/modules/{{ moduleKey }}/import-winners-csv">Dodaj kilka ID naraz</a>
        {% endif %}
        <a class="btn btn-outline-secondary" href="{{ backUrl|default('/cms/modules/' ~ moduleKey) }}">Wróć</a>
    </div>
</div>

<div class="card p-4">
    {% set readOnlyMode = readOnly|default(false) %}
    {% if alert %}
        <div class="alert alert-{{ alert.type }} mb-3">{{ alert.message }}</div>
    {% endif %}
    {% if errors is not empty %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
    <form method="post" enctype="multipart/form-data">
        {% include 'backend/_csrf_token.html.twig' %}
        {% set hasWysiwyg = false %}
        {% set hasDateTime = false %}
        {% set tabs = [] %}
        {% set hasTabs = false %}
        {% set currentTabKey = 'default' %}
        {% set currentTabLabel = '' %}
        {% set sections = [] %}
        {% set currentSection = { label: null, text: null, fields: [], tabKey: currentTabKey } %}
        {% set hasDependentRelations = false %}
        {% set hasConditionalVisibility = false %}
        {% for field in fields %}
            {% set fieldType = field.type|default('text')|lower %}
                {% set isFieldReadOnly = readOnlyMode or field.readonly|default(false) %}
            {% if fieldType == 'tab' %}
                {% set hasTabs = true %}
                {% if tabs is empty and (currentSection.fields is not empty or currentSection.label or currentSection.text) %}
                    {% set tabs = [{ key: currentTabKey, label: currentTabLabel ?: 'Główna' }] %}
                {% endif %}
                {% if currentSection.fields is not empty or currentSection.label or currentSection.text %}
                    {% set sections = sections|merge([currentSection]) %}
                {% endif %}
                {% set currentTabKey = field.key|default(field.label|default('tab-' ~ loop.index)|lower|replace({' ': '-', '_': '-', '/': '-'})) %}
                {% set currentTabLabel = field.label|default(currentTabKey) %}
                {% set tabExists = false %}
                {% for existingTab in tabs %}
                    {% if existingTab.key == currentTabKey %}
                        {% set tabExists = true %}
                    {% endif %}
                {% endfor %}
                {% if not tabExists %}
                    {% set tabs = tabs|merge([{ key: currentTabKey, label: currentTabLabel }]) %}
                {% endif %}
                {% set currentSection = { label: null, text: null, fields: [], tabKey: currentTabKey } %}
            {% elseif fieldType == 'section' %}
                {% if currentSection.fields is not empty or currentSection.label or currentSection.text %}
                    {% set sections = sections|merge([currentSection]) %}
                {% endif %}
                {% set currentSection = {
                    label: field.label|default(''),
                    text: field.text|default(''),
                    fields: [],
                    tabKey: currentTabKey
                } %}
            {% else %}
                {% if fieldType == 'relation' and field.depends_on|default('') %}
                    {% set hasDependentRelations = true %}
                {% endif %}
                {% if field.visible_if is defined and field.visible_if %}
                    {% set hasConditionalVisibility = true %}
                {% endif %}
                {% set currentSection = currentSection|merge({ fields: currentSection.fields|merge([field]) }) %}
            {% endif %}
        {% endfor %}
        {% if currentSection.fields is not empty or currentSection.label or currentSection.text %}
            {% set sections = sections|merge([currentSection]) %}
        {% endif %}
        {% if hasTabs and tabs is empty %}
            {% set tabs = [{ key: 'default', label: 'Główna' }] %}
        {% endif %}
        {% set activeTabKey = (hasTabs and tabs is not empty) ? tabs[0].key : 'default' %}

        {% if hasTabs %}
            <ul class="nav nav-tabs mb-4" role="tablist">
                {% for tab in tabs %}
                    <li class="nav-item" role="presentation">
                        <button
                            class="nav-link {% if tab.key == activeTabKey %}active{% endif %}"
                            type="button"
                            data-module-tab-trigger="{{ tab.key }}"
                        >
                            {{ tab.label }}
                        </button>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% for section in sections %}
            {% set sectionTabKey = section.tabKey|default('default') %}
            <div data-module-tab-panel="{{ sectionTabKey }}"{% if hasTabs and sectionTabKey != activeTabKey %} class="d-none"{% endif %}>
            {% set hasHeader = section.label or section.text %}
            {% if hasHeader %}
                <div class="border rounded p-3 mb-4">
                    {% if section.label %}
                        <h2 class="h5 mb-1">{{ section.label }}</h2>
                    {% endif %}
                    {% if section.text %}
                        <p class="text-muted mb-3">{{ section.text }}</p>
                    {% endif %}
            {% endif %}
            {% for field in section.fields %}
                {% set fieldName = field.name|default('') %}
                {% set fieldType = field.type|default('text')|lower %}
                {% set isFieldReadOnly = readOnlyMode or field.readonly|default(false) %}
                {% if fieldName and (field.form is not defined or field.form) %}
                    {% set visibleIf = field.visible_if|default(null) %}
                    {% set visibleIfField = '' %}
                    {% set visibleIfValues = [] %}
                    {% if visibleIf %}
                        {% if visibleIf.field is defined %}
                            {% set visibleIfField = visibleIf.field %}
                        {% elseif visibleIf.name is defined %}
                            {% set visibleIfField = visibleIf.name %}
                        {% elseif visibleIf[0] is defined and visibleIf[0] is not iterable %}
                            {% set visibleIfField = visibleIf[0] %}
                        {% endif %}
                        {% if visibleIf.values is defined %}
                            {% set visibleIfValues = visibleIf.values is iterable ? visibleIf.values : [visibleIf.values] %}
                        {% elseif visibleIf.value is defined %}
                            {% set visibleIfValues = [visibleIf.value] %}
                        {% elseif visibleIf[1] is defined %}
                            {% set rawVisibleIfValues = visibleIf[1] %}
                            {% set visibleIfValues = rawVisibleIfValues is iterable ? rawVisibleIfValues : [rawVisibleIfValues] %}
                        {% endif %}
                    {% endif %}
                    <div
                        class="mb-3"
                        {% if visibleIfField and visibleIfValues is not empty %}
                            data-visible-if-field="{{ visibleIfField }}"
                            data-visible-if-values="{{ visibleIfValues|json_encode|e('html_attr') }}"
                        {% endif %}
                    >
                        {% set fieldLabel = field.label|default(fieldName) %}
                        {% if plainReadOnlyView %}
                            {% set rawDisplayValue = values[fieldName]|default('') %}
                            {% set displayValue = rawDisplayValue %}
                            {% if fieldType in ['select', 'relation'] %}
                                {% set optionLabels = field.options|default({})|merge(field.selected_options|default({})) %}
                                {% if rawDisplayValue is iterable %}
                                    {% set displayParts = [] %}
                                    {% for item in rawDisplayValue %}
                                        {% set optionKey = item ~ '' %}
                                        {% set displayParts = displayParts|merge([optionLabels[optionKey]|default(optionKey)]) %}
                                    {% endfor %}
                                    {% set displayValue = displayParts|join(', ') %}
                                {% else %}
                                    {% set optionKey = rawDisplayValue ~ '' %}
                                    {% set displayValue = optionLabels[optionKey]|default(rawDisplayValue) %}
                                {% endif %}
                            {% elseif fieldType in ['checkbox', 'boolean', 'boolean_select'] %}
                                {% set displayValue = (rawDisplayValue is same as(true) or rawDisplayValue == 1 or rawDisplayValue == '1') ? 'Tak' : 'Nie' %}
                            {% elseif fieldType in ['date', 'datetime'] %}
                                {% set dateDisplayValue = rawDisplayValue|trim %}
                                {% if dateDisplayValue|lower == 'null' or dateDisplayValue matches '/^0{4}-0{2}-0{2}(?:\s+0{2}:0{2}(?::0{2})?)?$/' %}
                                    {% set displayValue = '' %}
                                {% endif %}
                            {% endif %}
                            {% set relatedDisplayType = field.display_type|default('text')|lower %}
                            {% set shouldShowLargeImage = (fieldType == 'image') or (fieldType in ['related_field', 'relation_field'] and relatedDisplayType == 'image') %}
                            <div class="module-text-preview-row mb-3">
                                {% if shouldShowLargeImage %}
                                    <div class="fw-semibold text-muted mb-2">{{ fieldLabel }}:</div>
                                    {% if rawDisplayValue %}
                                        <a href="{{ rawDisplayValue }}" target="_blank" rel="noopener noreferrer" class="d-block w-100">
                                            <img
                                                class="img-fluid rounded border bg-light d-block"
                                                src="{{ rawDisplayValue }}"
                                                alt="Podgląd {{ fieldLabel }}"
                                                style="width: 100%; max-height: 75vh; object-fit: contain;"
                                            >
                                        </a>
                                    {% else %}
                                        <div class="text-muted">—</div>
                                    {% endif %}
                                {% elseif fieldType == 'file' and rawDisplayValue %}
                                    <span class="fw-semibold text-muted">{{ fieldLabel }}:</span>
                                    <a href="{{ rawDisplayValue }}" target="_blank" rel="noopener noreferrer">Pobierz aktualny plik</a>
                                {% elseif fieldType in ['textarea', 'richtext', 'wysiwyg', 'json', 'json_pretty'] or relatedDisplayType in ['textarea', 'richtext', 'wysiwyg', 'json', 'json_pretty'] %}
                                    <div class="fw-semibold text-muted mb-1">{{ fieldLabel }}:</div>
                                    <div class="text-body" style="white-space: pre-wrap;">{{ displayValue ?: '—' }}</div>
                                {% else %}
                                    <span class="fw-semibold text-muted">{{ fieldLabel }}:</span>
                                    <span class="text-body">{{ displayValue ?: '—' }}</span>
                                {% endif %}
                            </div>
                        {% else %}
                            <label class="form-label">{{ fieldLabel }}</label>
                        {% if fieldType == 'wysiwyg' %}
                            {% set hasWysiwyg = true %}
                            <textarea class="form-control wysiwyg-editor" name="{{ fieldName }}" id="field-{{ fieldName }}" rows="6" data-wysiwyg="true"{% if isFieldReadOnly %} readonly data-wysiwyg-readonly="true"{% endif %}>{{ values[fieldName]|default('') }}</textarea>
                        {% elseif fieldType in ['textarea', 'richtext'] %}
                            <textarea class="form-control" name="{{ fieldName }}" rows="4"{% if isFieldReadOnly %} readonly{% endif %}>{{ values[fieldName]|default('') }}</textarea>
                        {% elseif fieldType == 'json' %}
                            <textarea
                                class="form-control"
                                name="{{ fieldName }}"
                                rows="{{ field.rows|default(8) }}"
                                data-json-pretty-field="true"
                                data-json-readonly="{{ isFieldReadOnly ? '1' : '0' }}"
                                {% if isFieldReadOnly %} readonly{% endif %}
                            >{{ values[fieldName]|default('') }}</textarea>
                            <div class="form-text">Pole obsługuje JSON. Dane są automatycznie formatowane dla lepszej czytelności.</div>
                        {% elseif fieldType == 'json_pretty' %}
                            <pre
                                class="form-control mb-0 bg-light p-3"
                                style="min-height: {{ (field.rows|default(8) * 1.5)|number_format(0, '.', '') }}rem; white-space: pre-wrap;"
                                data-json-pretty-display="true"
                            >{{ values[fieldName]|default('') }}</pre>
                        {% elseif fieldType == 'info' %}
                            {% set displayTextProvider = field.display_text_provider|default('') %}
                            {% set displayText = displayTextProvider ? configured_field_text(displayTextProvider, field, values) : '' %}
                            <div class="alert alert-info mb-0">
                                {% if field.text|default('') %}
                                    <div class="{{ displayText ? 'mb-2' : '' }}">{{ field.text|nl2br }}</div>
                                {% endif %}
                                {% if displayText %}
                                    <label class="form-label fw-semibold" for="field-{{ fieldName }}">{{ field.display_text_label|default(fieldLabel) }}</label>
                                    <textarea
                                        class="form-control{% if field.display_text_monospace|default(false) %} font-monospace{% endif %}"
                                        id="field-{{ fieldName }}"
                                        rows="{{ field.display_text_rows|default(2) }}"
                                        readonly
                                        {% if field.display_text_select_on_click|default(false) %}onclick="this.select();"{% endif %}
                                    >{{ displayText }}</textarea>
                                    {% if field.display_text_help|default('') %}
                                        <div class="form-text">{{ field.display_text_help }}</div>
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% elseif fieldType in ['checkbox', 'boolean'] %}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="{{ fieldName }}" id="field-{{ fieldName }}" value="1" {% if values[fieldName]|default(false) %}checked{% endif %}{% if isFieldReadOnly %} disabled{% endif %}>
                                <label class="form-check-label" for="field-{{ fieldName }}">Tak</label>
                            </div>
                        {% elseif fieldType == 'boolean_select' %}
                            {% set rawValue = values[fieldName] is defined ? values[fieldName] : null %}
                            {% set normalizedValue = (rawValue is same as(true) or rawValue == 1 or rawValue == '1') ? '1' : '0' %}
                            <select class="form-select" name="{{ fieldName }}" id="field-{{ fieldName }}"{% if isFieldReadOnly %} disabled{% endif %}>
                                <option value="1" {% if normalizedValue == '1' %}selected{% endif %}>Tak</option>
                                <option value="0" {% if normalizedValue == '0' %}selected{% endif %}>Nie</option>
                            </select>
                        {% elseif fieldType == 'date' %}
                            {% set rawDateValue = values[fieldName]|default('')|trim %}
                            {% set normalizedDateValue = rawDateValue %}
                            {% if rawDateValue|lower == 'null' or rawDateValue matches '/^0{4}-0{2}-0{2}$/' %}
                                {% set normalizedDateValue = '' %}
                            {% endif %}
                            <div class="input-group">
                                <input class="form-control" type="date" name="{{ fieldName }}" id="field-{{ fieldName }}" value="{{ normalizedDateValue }}"{% if isFieldReadOnly %} readonly{% endif %}>
                                {% if not isFieldReadOnly %}
                                    <button
                                        class="btn btn-outline-secondary"
                                        type="button"
                                        data-set-current-date="true"
                                        data-target-id="field-{{ fieldName }}"
                                    >
                                        Dzisiaj
                                    </button>
                                {% endif %}
                            </div>
                        {% elseif fieldType == 'datetime' %}
                            {% set hasDateTime = true %}
                            {% set rawDateTimeValue = values[fieldName]|default('')|trim %}
                            {% set normalizedDateTimeValue = rawDateTimeValue %}
                            {% if rawDateTimeValue|lower == 'null' or rawDateTimeValue matches '/^0{4}-0{2}-0{2}(?:\\s+0{2}:0{2}(?::0{2})?)?$/' %}
                                {% set normalizedDateTimeValue = '' %}
                            {% endif %}
                            <input
                                class="form-control"
                                type="text"
                                name="{{ fieldName }}"
                                id="field-{{ fieldName }}"
                                value="{{ normalizedDateTimeValue }}"
                                data-datetime-picker="true"
                                placeholder="YYYY-MM-DD HH:MM:SS"
                                autocomplete="off"
                                {% if isFieldReadOnly %}readonly{% endif %}
                            >
                            {% if not isFieldReadOnly %}
                                <button
                                    class="btn btn-outline-secondary mt-2"
                                    type="button"
                                    data-set-current-datetime="true"
                                    data-target-id="field-{{ fieldName }}"
                                >
                                    Ustaw teraz
                                </button>
                            {% endif %}
                        {% elseif fieldType == 'select' %}
                            {% set isMultiple = field.multiple|default(false) %}
                            {% set renderMode = field.render|default('select') %}
                            {% set selectedValue = values[fieldName]|default(isMultiple ? [] : '') %}
                            {% if isMultiple and selectedValue is not iterable %}
                                {% set selectedValue = [] %}
                            {% endif %}

                            {% if renderMode == 'checkboxes' and isMultiple %}
                                <div class="d-flex flex-column gap-2">
                                    {% for optionValue, optionLabel in field.options|default({}) %}
                                        {% set checkboxId = 'field-' ~ fieldName ~ '-' ~ loop.index %}
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="{{ fieldName }}[]" id="{{ checkboxId }}" value="{{ optionValue }}" {% if optionValue in selectedValue %}checked{% endif %}{% if isFieldReadOnly %} disabled{% endif %}>
                                            <label class="form-check-label" for="{{ checkboxId }}">{{ optionLabel }}</label>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <select
                                    class="form-select"
                                    name="{{ fieldName }}{% if isMultiple %}[]{% endif %}"
                                    id="field-{{ fieldName }}"
                                    {% if isMultiple %} multiple{% endif %}
                                    {% if isFieldReadOnly %} disabled{% endif %}
                                >
                                    {% if not isMultiple and field.placeholder is defined and field.placeholder %}
                                        <option value="" disabled{% if selectedValue == '' %} selected{% endif %}>{{ field.placeholder }}</option>
                                    {% endif %}
                                    {% if field.option_groups|default({}) is not empty %}
                                        {% for groupLabel, groupOptions in field.option_groups|default({}) %}
                                            <optgroup label="{{ groupLabel }}">
                                                {% for optionValue, optionLabel in groupOptions %}
                                                    <option value="{{ optionValue }}" {% if isMultiple ? (optionValue in selectedValue) : (optionValue == selectedValue) %}selected{% endif %}>
                                                        {{ optionLabel }}
                                                    </option>
                                                {% endfor %}
                                            </optgroup>
                                        {% endfor %}
                                    {% else %}
                                        {% for optionValue, optionLabel in field.options|default({}) %}
                                            <option value="{{ optionValue }}" {% if isMultiple ? (optionValue in selectedValue) : (optionValue == selectedValue) %}selected{% endif %}>
                                                {{ optionLabel }}
                                            </option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            {% endif %}
                        {% elseif fieldType == 'relation' %}
                            {% set isMultiple = field.multiple|default(false) %}
                            {% set renderMode = field.render|default('select') %}
                            {% set selectedValue = values[fieldName]|default(isMultiple ? [] : '') %}
                            {% set optionMeta = field.option_meta|default({}) %}
                            {% set isRemote = field.remote|default(false) %}
                            {% if isMultiple and selectedValue is not iterable %}
                                {% set selectedValue = [] %}
                            {% endif %}
                            {% if isRemote %}
                                {% set selectedOptions = field.selected_options|default({}) %}
                                {% if selectedOptions is empty and selectedValue %}
                                    {% if selectedValue is iterable %}
                                        {% for fallbackValue in selectedValue %}
                                            {% if fallbackValue %}
                                                {% set selectedOptions = selectedOptions|merge({ (fallbackValue): fallbackValue }) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        {% set selectedOptions = { (selectedValue): selectedValue } %}
                                    {% endif %}
                                {% endif %}
                                {% if isFieldReadOnly %}
                                    {% set displayValue = '' %}
                                        {% if selectedOptions is not empty %}
                                            {% set displayValue = selectedOptions|join(', ') %}
                                    {% elseif selectedValue is iterable %}
                                        {% set displayValue = selectedValue|join(', ') %}
                                    {% else %}
                                        {% set displayValue = selectedValue %}
                                    {% endif %}
                                    <input class="form-control" type="text" value="{{ displayValue }}" readonly>
                                {% else %}
                                    {% set searchPlaceholder = field.search_placeholder|default(field.placeholder|default('Szukaj')) %}
                                    <div
                                        class="relation-search"
                                        data-relation-search="true"
                                        data-field-name="{{ fieldName }}"
                                        data-search-url="/cms/modules/{{ moduleKey }}/relation-search/{{ fieldName }}"
                                        data-multiple="{{ isMultiple ? '1' : '0' }}"
                                        data-search-filters="{{ field.search_filters|default({})|json_encode|e('html_attr') }}"
                                    >
                                        <input
                                            type="text"
                                            class="form-control relation-search-input"
                                            placeholder="{{ searchPlaceholder }}"
                                            autocomplete="off"
                                        >
                                        <div class="relation-search-selected mt-2">
                                            {% for optionValue, optionLabel in selectedOptions %}
                                                <span class="badge bg-primary relation-search-chip" data-value="{{ optionValue }}">
                                                    {{ optionLabel }}
                                                    <button type="button" class="btn-close btn-close-white relation-remove" aria-label="Usuń"></button>
                                                </span>
                                                <input type="hidden" name="{{ fieldName }}{% if isMultiple %}[]{% endif %}" value="{{ optionValue }}">
                                            {% endfor %}
                                        </div>
                                        <div class="list-group relation-search-results"></div>
                                    </div>
                                {% endif %}
                            {% elseif renderMode == 'checkboxes' and isMultiple %}
                                <div class="d-flex flex-column gap-2">
                                    {% for optionValue, optionLabel in field.options|default({}) %}
                                        {% set checkboxId = 'field-' ~ fieldName ~ '-' ~ loop.index %}
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="{{ fieldName }}[]" id="{{ checkboxId }}" value="{{ optionValue }}" {% if optionValue in selectedValue %}checked{% endif %}{% if isFieldReadOnly %} disabled{% endif %}>
                                            <label class="form-check-label" for="{{ checkboxId }}">{{ optionLabel }}</label>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <select
                                    class="form-select"
                                    name="{{ fieldName }}{% if isMultiple %}[]{% endif %}"
                                    id="field-{{ fieldName }}"
                                    {% if isMultiple %} multiple{% endif %}
                                    {% if isFieldReadOnly %} disabled{% endif %}
                                    {% if field.depends_on|default('') %}
                                        data-depends-on="{{ field.depends_on }}"
                                        data-no-dependency-label="{{ field.depends_no_dependency_label|default('Najpierw wybierz wartość nadrzędną') }}"
                                        data-empty-label="{{ field.depends_empty_label|default('Brak opcji dla wybranego elementu') }}"
                                        data-placeholder="{{ field.placeholder|default('') }}"
                                    {% endif %}
                                >
                                    {% if not isMultiple %}
                                        {% if field.placeholder is defined and field.placeholder %}
                                            <option value="" disabled{% if selectedValue == '' %} selected{% endif %}>{{ field.placeholder }}</option>
                                        {% else %}
                                            <option value="" {% if selectedValue == '' %}selected{% endif %}></option>
                                        {% endif %}
                                    {% endif %}
                                    {% if field.option_groups|default({}) is not empty %}
                                        {% for groupLabel, groupOptions in field.option_groups|default({}) %}
                                            <optgroup label="{{ groupLabel }}">
                                                {% for optionValue, optionLabel in groupOptions %}
                                                    {% set meta = optionMeta[optionValue]|default({}) %}
                                                    <option
                                                        value="{{ optionValue }}"
                                                        {% if isMultiple ? (optionValue in selectedValue) : (optionValue == selectedValue) %}selected{% endif %}
                                                        {% if meta.depends_value is defined %} data-depends-value="{{ meta.depends_value }}"{% endif %}
                                                        {% if meta.disabled|default(false) %} disabled class="text-muted"{% endif %}
                                                    >
                                                        {{ optionLabel }}
                                                    </option>
                                                {% endfor %}
                                            </optgroup>
                                        {% endfor %}
                                    {% else %}
                                        {% for optionValue, optionLabel in field.options|default({}) %}
                                            {% set meta = optionMeta[optionValue]|default({}) %}
                                            <option
                                                value="{{ optionValue }}"
                                                {% if isMultiple ? (optionValue in selectedValue) : (optionValue == selectedValue) %}selected{% endif %}
                                                {% if meta.depends_value is defined %} data-depends-value="{{ meta.depends_value }}"{% endif %}
                                                {% if meta.disabled|default(false) %} disabled class="text-muted"{% endif %}
                                            >
                                                {{ optionLabel }}
                                            </option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                            {% endif %}

                        {% elseif fieldType == 'link_list' %}
                            {% set selectedLinks = values[fieldName]|default([]) %}
                            {% if selectedLinks is not iterable %}
                                {% set selectedLinks = [] %}
                            {% endif %}
                            {% set relationOptions = field.options|default({}) %}
                            {% if isFieldReadOnly %}
                                {% if selectedLinks is empty %}
                                    <input class="form-control" type="text" value="" readonly>
                                {% else %}
                                    <ul class="list-group">
                                        {% for linkItem in selectedLinks %}
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <span>{{ linkItem.nazwa|default('') }}</span>
                                                <span class="text-muted">{{ relationOptions[linkItem.file_id|default('')]|default(linkItem.file_id|default('')) }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            {% else %}
                                <div class="link-list-editor" data-link-list-editor="true">
                                    <input type="hidden" name="{{ fieldName }}" value="" data-link-list-input="true">
                                    <div class="d-flex justify-content-end mb-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm" data-link-list-add="true">Dodaj</button>
                                    </div>
                                    <div class="d-flex flex-column gap-2" data-link-list-items="true">
                                        {% for linkItem in selectedLinks %}
                                            <div class="border rounded p-3" data-link-list-item="true">
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-5">
                                                        <label class="form-label">Nazwa</label>
                                                        <input type="text" class="form-control" data-link-list-name="true" value="{{ linkItem.nazwa|default('') }}">
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="form-label">Plik</label>
                                                        <select class="form-select" data-link-list-file="true">
                                                            <option value="">Wybierz plik</option>
                                                            {% for optionValue, optionLabel in relationOptions %}
