{% if hasDependentRelations %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('select[data-depends-on]').forEach((select) => {
                const dependsOn = select.dataset.dependsOn;
                if (!dependsOn) {
                    return;
                }

                const dependencySelect = document.getElementById(`field-${dependsOn}`);
                if (!dependencySelect) {
                    return;
                }

                const allOptions = Array.from(select.options).map((option) => ({
                    value: option.value,
                    label: option.textContent,
                    dependsValue: option.dataset.dependsValue || '',
                }));
                const placeholderOption = allOptions.find((option) => option.value === '');
                const placeholderLabel = select.dataset.placeholder || (placeholderOption ? placeholderOption.label : '');
                const noDependencyLabel = select.dataset.noDependencyLabel || placeholderLabel || 'Najpierw wybierz wartość nadrzędną';
                const emptyLabel = select.dataset.emptyLabel || 'Brak opcji dla wybranego elementu';

                const renderOptions = (selectedDependency, keepValue) => {
                    const previousValue = keepValue ? select.value : '';
                    select.innerHTML = '';

                    const filteredOptions = allOptions.filter((option) => {
                        if (option.value === '') {
                            return true;
                        }

                        return selectedDependency !== '' && option.dependsValue === selectedDependency;
                    });

                    if (placeholderOption) {
                        const placeholder = document.createElement('option');
                        placeholder.value = '';
                        if (selectedDependency === '') {
                            placeholder.textContent = noDependencyLabel;
                            placeholder.selected = true;
                        } else if (filteredOptions.length === 1) {
                            placeholder.textContent = emptyLabel;
                            placeholder.selected = true;
                        } else {
                            placeholder.textContent = placeholderLabel;
                        }
                        select.appendChild(placeholder);
                    }

                    filteredOptions.forEach((option) => {
                        if (option.value === '') {
                            return;
                        }

                        const newOption = document.createElement('option');
                        newOption.value = option.value;
                        newOption.textContent = option.label;
                        if (option.dependsValue) {
                            newOption.dataset.dependsValue = option.dependsValue;
                        }
                        select.appendChild(newOption);
                    });

                    if (previousValue && Array.from(select.options).some((option) => option.value === previousValue)) {
                        select.value = previousValue;
                    }
                };

                renderOptions(dependencySelect.value, true);
                dependencySelect.addEventListener('change', () => {
                    renderOptions(dependencySelect.value, false);
                });
            });
        });
    </script>
