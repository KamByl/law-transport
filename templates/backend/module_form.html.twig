<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-json-pretty-field="true"]').forEach((field) => {
            if (!(field instanceof HTMLTextAreaElement)) {
                return;
            }

            const formatValue = () => {
                const rawValue = field.value.trim();
                if (rawValue === '') {
                    return;
                }

                try {
                    const parsed = JSON.parse(rawValue);
                    field.value = JSON.stringify(parsed, null, 2);
                } catch (error) {
                    // Zostawiamy oryginalny tekst, jeśli wartość nie jest poprawnym JSON-em.
                }
            };

            formatValue();

            if (field.dataset.jsonReadonly !== '1') {
                field.addEventListener('blur', formatValue);
            }
        });

        document.querySelectorAll('[data-json-pretty-display="true"]').forEach((field) => {
            const rawValue = (field.textContent || '').trim();
            if (rawValue === '') {
                field.textContent = '—';
                return;
            }

            const formatStructuredList = (value) => {
                if (!Array.isArray(value) || value.length === 0) {
                    return null;
                }

                const lines = [];

                value.forEach((item, index) => {
                    lines.push(`${index + 1}.`);

                    if (item && typeof item === 'object' && !Array.isArray(item)) {
                        Object.entries(item).forEach(([key, itemValue]) => {
                            const normalizedValue = itemValue === null
                                ? 'null'
                                : (typeof itemValue === 'object' ? JSON.stringify(itemValue) : String(itemValue));
                            lines.push(`${key}: ${normalizedValue}`);
                        });
                    } else {
                        lines.push(String(item));
                    }

                    lines.push('');
                });

                return lines.join('\n').trim();
            };

            try {
                const parsed = JSON.parse(rawValue);
                const structuredList = formatStructuredList(parsed);
                field.textContent = structuredList ?? JSON.stringify(parsed, null, 2);
            } catch (error) {
                // Zostawiamy oryginalny tekst, jeśli wartość nie jest poprawnym JSON-em.
            }
        });

        const formatUploadSpeed = (bytesPerSecond) => {
            if (!Number.isFinite(bytesPerSecond) || bytesPerSecond <= 0) {
                return '';
            }

            const units = ['B/s', 'KB/s', 'MB/s', 'GB/s'];
            let speed = bytesPerSecond;
            let unitIndex = 0;
            while (speed >= 1024 && unitIndex < units.length - 1) {
                speed /= 1024;
                unitIndex++;
            }

            const precision = speed >= 10 || unitIndex === 0 ? 0 : 1;
            return `${speed.toFixed(precision)} ${units[unitIndex]}`;
        };

        const uploadVideoChunk = (url, formData, onProgress) => new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', url, true);
            xhr.withCredentials = true;
            xhr.setRequestHeader('X-CSRF-Token', adminCsrfToken);

            xhr.upload.onprogress = (event) => {
                if (event.lengthComputable) {
                    onProgress(event.loaded);
                }
            };

            xhr.onload = () => {
                const rawPayload = xhr.responseText || '';
                let payload = {};
                if (rawPayload !== '') {
                    try {
                        payload = JSON.parse(rawPayload);
                    } catch (parseError) {
                        payload = { error: rawPayload };
                    }
                }

                if (xhr.status < 200 || xhr.status >= 300) {
                    reject({
                        isUploadResponseError: true,
                        status: xhr.status,
                        payload,
                        rawPayload
                    });
                    return;
                }

                resolve({ payload, rawPayload });
            };

            xhr.onerror = () => reject(new Error('Upload network error'));
            xhr.onabort = () => reject(new Error('Upload aborted'));
            xhr.send(formData);
        });

        document.querySelectorAll('[data-video-upload="true"]').forEach((wrapper) => {
            const fileInput = wrapper.querySelector('[data-video-input="true"]');
            const hiddenInput = wrapper.querySelector('[data-video-hidden-input="true"]');
            const status = wrapper.querySelector('[data-video-status="true"]');
            const progressWrapper = wrapper.querySelector('[data-video-progress-wrapper="true"]');
            const progressBar = wrapper.querySelector('[data-video-progress-bar="true"]');
            const previewWrapper = wrapper.querySelector('[data-video-preview-wrapper="true"]');
            const preview = wrapper.querySelector('[data-video-preview="true"]');
            const removeCheckbox = wrapper.querySelector('[data-video-remove-checkbox="true"]');
            const uploadUrl = wrapper.dataset.uploadUrl || '';
            const fieldName = wrapper.dataset.fieldName || '';
            const maxSizeMb = wrapper.dataset.maxSizeMb || '300';
            if (!(fileInput instanceof HTMLInputElement) || !(hiddenInput instanceof HTMLInputElement) || !status || !progressWrapper || !progressBar || !uploadUrl || !fieldName) {
                return;
            }

            const clearVideo = () => {
                hiddenInput.value = '';
                if (previewWrapper) previewWrapper.classList.add('d-none');
                if (preview instanceof HTMLVideoElement) {
                    preview.removeAttribute('src');
                    preview.load();
                }
                status.textContent = `Maksymalny rozmiar: ${maxSizeMb} MB.`;
            };

            if (removeCheckbox instanceof HTMLInputElement) {
                removeCheckbox.addEventListener('change', () => {
                    if (removeCheckbox.checked) {
                        clearVideo();
                    }
                });
            }

            fileInput.addEventListener('change', async () => {
                const file = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;
                if (!file) return;
                if (activeVideoUploads > 0) {
                    status.textContent = 'Trwa już upload filmu. Poczekaj na jego zakończenie.';
                    return;
                }
                const chunkSize = 5 * 1024 * 1024;
                const totalChunks = Math.ceil(file.size / chunkSize);
                const uploadIdKey = `video-upload-${fieldName}-${file.name}-${file.size}`;
                const uploadId = localStorage.getItem(uploadIdKey) || `${Date.now()}-${Math.random().toString(16).slice(2)}`;
                localStorage.setItem(uploadIdKey, uploadId);
                let startChunk = Number(localStorage.getItem(`${uploadIdKey}-chunk`) || '0');
                if (!Number.isFinite(startChunk) || startChunk < 0 || startChunk >= totalChunks) {
                    startChunk = 0;
                }
                progressWrapper.classList.remove('d-none');
                setModuleFormUploadingState(true);
                status.textContent = 'Wgrywanie...';
                const uploadedBytesAtStart = Math.min(file.size, startChunk * chunkSize);
                const uploadStartedAt = performance.now();
                let lastDisplayedPercent = -1;
                let lastProgressRenderAt = 0;

                const updateProgress = (uploadedBytes, force = false) => {
                    const normalizedUploadedBytes = Math.max(0, Math.min(file.size, uploadedBytes));
                    const percent = normalizedUploadedBytes >= file.size
                        ? 100
                        : Math.floor((normalizedUploadedBytes / file.size) * 100);
                    const now = performance.now();
                    if (!force && percent === lastDisplayedPercent && now - lastProgressRenderAt < 1000) {
                        return;
                    }

                    lastDisplayedPercent = percent;
                    lastProgressRenderAt = now;
                    const elapsedSeconds = Math.max(0.001, (now - uploadStartedAt) / 1000);
                    const uploadedSinceStart = Math.max(0, normalizedUploadedBytes - uploadedBytesAtStart);
                    const speed = formatUploadSpeed(uploadedSinceStart / elapsedSeconds);
                    progressBar.style.width = `${percent}%`;
                    progressBar.textContent = `${percent}%`;
                    progressBar.setAttribute('aria-valuenow', String(percent));
                    status.textContent = speed
                        ? `Wgrywanie... ${percent}% (${speed})`
                        : `Wgrywanie... ${percent}%`;
                };

                updateProgress(uploadedBytesAtStart, true);

                try {
                    for (let chunkIndex = startChunk; chunkIndex < totalChunks; chunkIndex++) {
                        const start = chunkIndex * chunkSize;
                        const end = Math.min(file.size, start + chunkSize);
                        const chunkBlob = file.slice(start, end);
                        const formData = new FormData();
                        formData.append('uploadId', uploadId);
                        formData.append('chunkIndex', String(chunkIndex));
                        formData.append('totalChunks', String(totalChunks));
                        formData.append('originalName', file.name);
                        formData.append('chunk', chunkBlob, file.name);

                        let uploadResult;
                        try {
                            uploadResult = await uploadVideoChunk(uploadUrl, formData, (chunkUploadedBytes) => {
                                updateProgress(start + chunkUploadedBytes);
                            });
                        } catch (error) {
                            if (error && error.isUploadResponseError) {
                                const rawPayload = String(error.rawPayload || '');
                                const fallbackError = rawPayload.trim() !== ''
                                    ? rawPayload.trim()
                                    : `Błąd uploadu (${error.status}).`;
                                status.textContent = error.payload.error || fallbackError;
                                return;
                            }
                            throw error;
                        }

                        const payload = uploadResult.payload;
                        updateProgress(end, true);
                        if (chunkIndex === totalChunks - 1 && !payload.done) {
                            status.textContent = 'Przetwarzanie filmu...';
                        }

                        if (payload.error) {
                            status.textContent = payload.error;
                            return;
                        }
                        localStorage.setItem(`${uploadIdKey}-chunk`, String(chunkIndex + 1));

                        if (payload.done && payload.path) {
                            hiddenInput.value = payload.path;
                            if (previewWrapper) previewWrapper.classList.remove('d-none');
                            if (preview instanceof HTMLVideoElement) {
                                preview.src = payload.path;
                                preview.load();
                            }
                            if (removeCheckbox instanceof HTMLInputElement) {
                                removeCheckbox.checked = false;
                            }
                            status.innerHTML = `Upload zakończony. <a href="${payload.path}" target="_blank" rel="noopener noreferrer">Pobierz aktualny film</a>`;
                            localStorage.removeItem(uploadIdKey);
                            localStorage.removeItem(`${uploadIdKey}-chunk`);
                        }
                    }
                } catch (error) {
                    status.textContent = 'Nie udało się wysłać pliku. Sprawdź połączenie i spróbuj ponownie.';
                } finally {
                    setModuleFormUploadingState(false);
                }
            });
        });

    });
</script>
