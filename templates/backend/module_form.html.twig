                                                        </select>
                                                    </div>
                                                    <div class="col-md-2 d-flex gap-2 justify-content-md-end">
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-link-list-up="true" title="Przesuń w górę">↑</button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-link-list-down="true" title="Przesuń w dół">↓</button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm" data-link-list-remove="true">Usuń</button>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <template data-link-list-template="true">
                                        <div class="border rounded p-3" data-link-list-item="true">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-5">
                                                    <label class="form-label">Nazwa</label>
                                                    <input type="text" class="form-control" data-link-list-name="true" value="">
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label">Plik</label>
                                                    <select class="form-select" data-link-list-file="true">
                                                        <option value="">Wybierz plik</option>
                                                        {% for optionValue, optionLabel in relationOptions %}
                                                            <option value="{{ optionValue }}">{{ optionLabel }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="col-md-2 d-flex gap-2 justify-content-md-end">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-link-list-up="true" title="Przesuń w górę">↑</button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-link-list-down="true" title="Przesuń w dół">↓</button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm" data-link-list-remove="true">Usuń</button>
                                                </div>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            {% endif %}
                        {% elseif fieldType in ['related_field', 'relation_field'] %}
                            {% set relatedDisplayType = field.display_type|default('text')|lower %}
                            {% set relatedValue = values[fieldName]|default('') %}
                            {% set isRelatedFieldEditable = field.editable|default(false) and not isFieldReadOnly %}
                            {% if isRelatedFieldEditable and relatedDisplayType == 'select' %}
                                <select class="form-select" name="{{ fieldName }}" id="field-{{ fieldName }}">
                                    {% if field.placeholder is defined and field.placeholder %}
                                        <option value=""{% if relatedValue == '' %} selected{% endif %}>{{ field.placeholder }}</option>
                                    {% endif %}
                                    {% for optionValue, optionLabel in field.options|default({}) %}
                                        <option value="{{ optionValue }}" {% if optionValue == relatedValue %}selected{% endif %}>{{ optionLabel }}</option>
                                    {% endfor %}
                                </select>
                                <div class="form-text">Zmiana zostanie zapisana w powiązanym zgłoszeniu.</div>
                            {% elseif isRelatedFieldEditable and relatedDisplayType in ['text', 'email', 'url', 'number'] %}
                                <input class="form-control" type="{{ relatedDisplayType == 'number' ? 'number' : (relatedDisplayType == 'email' ? 'email' : (relatedDisplayType == 'url' ? 'url' : 'text')) }}" name="{{ fieldName }}" id="field-{{ fieldName }}" value="{{ relatedValue }}">
                                <div class="form-text">Zmiana zostanie zapisana w powiązanym zgłoszeniu.</div>
                            {% elseif isRelatedFieldEditable and relatedDisplayType in ['textarea', 'richtext', 'wysiwyg', 'json', 'json_pretty'] %}
                                <textarea class="form-control" name="{{ fieldName }}" id="field-{{ fieldName }}" rows="{{ field.rows|default(4) }}">{{ relatedValue }}</textarea>
                                <div class="form-text">Zmiana zostanie zapisana w powiązanym zgłoszeniu.</div>
                            {% elseif relatedDisplayType == 'image' %}
                                {% if relatedValue %}
                                    <div>
                                        <a href="{{ relatedValue }}" target="_blank" rel="noopener noreferrer" class="d-inline-block">
                                            <img class="img-thumbnail" src="{{ relatedValue }}" alt="Podgląd {{ field.label|default(fieldName) }}" style="max-height: 120px;">
                                        </a>
                                    </div>
                                {% else %}
                                    <input class="form-control" type="text" value="" readonly>
                                {% endif %}
                            {% elseif relatedDisplayType in ['textarea', 'richtext', 'wysiwyg', 'json', 'json_pretty'] %}
                                <pre class="form-control mb-0 bg-light p-3" style="min-height: {{ (field.rows|default(4) * 1.5)|number_format(0, '.', '') }}rem; white-space: pre-wrap;">{{ relatedValue }}</pre>
                            {% else %}
                                <input class="form-control" type="text" value="{{ relatedValue }}" readonly>
                            {% endif %}
                        {% elseif fieldType == 'structured_list' %}
                            {% set selectedItems = values[fieldName]|default([]) %}
                            {% if selectedItems is not iterable %}
                                {% set selectedItems = [] %}
                            {% endif %}
                            {% set structuredFields = field.fields|default([]) %}
                            {% if isFieldReadOnly %}
                                {% if selectedItems is empty %}
                                    <input class="form-control" type="text" value="" readonly>
                                {% else %}
                                    <div class="d-flex flex-column gap-2">
                                        {% for item in selectedItems %}
                                            <div class="border rounded p-3">
                                                <div class="row g-2">
                                                    {% for nestedField in structuredFields %}
                                                        {% set nestedName = nestedField.name|default('') %}
                                                        {% if nestedName %}
                                                            {% set nestedType = nestedField.type|default('text')|lower %}
                                                            <div class="col-md-6">
                                                                <div class="small text-muted">{{ nestedField.label|default(nestedName) }}</div>
                                                                {% if nestedType == 'image' and item[nestedName]|default('') is not empty %}
                                                                    <a href="{{ item[nestedName] }}" target="_blank" rel="noopener noreferrer" class="d-inline-block">
                                                                        <img class="img-thumbnail" src="{{ item[nestedName] }}" alt="Podgląd {{ nestedField.label|default(nestedName) }}" style="max-height: 80px;">
                                                                    </a>
                                                                {% else %}
                                                                    <div>{{ item[nestedName]|default('') }}</div>
                                                                {% endif %}
                                                            </div>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            {% else %}
                                <div class="structured-list-editor" data-structured-list-editor="true">
                                    <input type="hidden" name="{{ fieldName }}" value="" data-structured-list-input="true">
                                    <div class="d-flex justify-content-end mb-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm" data-structured-list-add="true">Dodaj</button>
                                    </div>
                                    <div class="d-flex flex-column gap-2" data-structured-list-items="true">
                                        {% for item in selectedItems %}
                                            <div class="border rounded p-3" data-structured-list-item="true">
                                                <div class="row g-2 align-items-end">
                                                    {% for nestedField in structuredFields %}
                                                        {% set nestedName = nestedField.name|default('') %}
                                                        {% if nestedName %}
                                                            {% set nestedType = nestedField.type|default('text')|lower %}
                                                            <div class="col-md-5">
                                                                <label class="form-label">{{ nestedField.label|default(nestedName) }}</label>
                                                                {% if nestedType == 'image' %}
                                                                    <input type="hidden" data-structured-list-value="{{ nestedName }}" value="{{ item[nestedName]|default('') }}">
                                                                    <input class="form-control" type="file" accept="image/*" data-structured-list-image-input="true" data-structured-list-image-name="{{ nestedName }}">
                                                                    <div class="small text-muted mt-1" data-structured-list-image-status="true">Wybierz zdjęcie do wgrania.</div>
                                                                    <div class="mt-2{% if item[nestedName]|default('') is empty %} d-none{% endif %}" data-structured-list-image-preview-wrapper="true">
                                                                        <a href="{{ item[nestedName]|default('') }}" target="_blank" rel="noopener noreferrer" data-structured-list-image-link="true">
                                                                            <img class="img-thumbnail" src="{{ item[nestedName]|default('') }}" alt="Podgląd {{ nestedField.label|default(nestedName) }}" style="max-height: 80px;" data-structured-list-image-preview="true">
                                                                        </a>
                                                                    </div>
                                                                {% else %}
                                                                    <input
                                                                        type="{{ nestedField.input_type|default('text') }}"
                                                                        class="form-control"
                                                                        data-structured-list-value="{{ nestedName }}"
                                                                        value="{{ item[nestedName]|default('') }}"
                                                                    >
                                                                {% endif %}
                                                            </div>
                                                        {% endif %}
                                                    {% endfor %}
                                                    <div class="col-md-2 d-flex gap-2 justify-content-md-end">
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-structured-list-up="true" title="Przesuń w górę">↑</button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-structured-list-down="true" title="Przesuń w dół">↓</button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm" data-structured-list-remove="true">Usuń</button>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <template data-structured-list-template="true">
                                        <div class="border rounded p-3" data-structured-list-item="true">
                                            <div class="row g-2 align-items-end">
                                                {% for nestedField in structuredFields %}
                                                    {% set nestedName = nestedField.name|default('') %}
                                                    {% if nestedName %}
                                                    {% set nestedType = nestedField.type|default('text')|lower %}
                                                        <div class="col-md-5">
                                                            <label class="form-label">{{ nestedField.label|default(nestedName) }}</label>
                                                            {% if nestedType == 'image' %}
                                                                <input type="hidden" data-structured-list-value="{{ nestedName }}" value="">
                                                                <input class="form-control" type="file" accept="image/*" data-structured-list-image-input="true" data-structured-list-image-name="{{ nestedName }}">
                                                                <div class="small text-muted mt-1" data-structured-list-image-status="true">Wybierz zdjęcie do wgrania.</div>
                                                                <div class="mt-2 d-none" data-structured-list-image-preview-wrapper="true">
                                                                    <a href="" target="_blank" rel="noopener noreferrer" data-structured-list-image-link="true">
                                                                        <img class="img-thumbnail" src="" alt="Podgląd {{ nestedField.label|default(nestedName) }}" style="max-height: 80px;" data-structured-list-image-preview="true">
                                                                    </a>
                                                                </div>
                                                            {% else %}
                                                                <input
                                                                    type="{{ nestedField.input_type|default('text') }}"
                                                                    class="form-control"
                                                                    data-structured-list-value="{{ nestedName }}"
                                                                    value=""
                                                                >
                                                            {% endif %}
                                                        </div>
                                                    {% endif %}
                                                {% endfor %}
                                                <div class="col-md-2 d-flex gap-2 justify-content-md-end">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-structured-list-up="true" title="Przesuń w górę">↑</button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-structured-list-down="true" title="Przesuń w dół">↓</button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm" data-structured-list-remove="true">Usuń</button>
                                                </div>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            {% endif %}
                        {% elseif fieldType == 'image' %}
                            {% if not isFieldReadOnly %}
                                <input class="form-control" type="file" name="{{ fieldName }}" accept="image/*">
                            {% endif %}
                            {% if values[fieldName]|default('') %}
                                <div class="mt-2">
                                    <a href="{{ values[fieldName] }}" target="_blank" rel="noopener noreferrer" class="d-inline-block">
                                        <img class="img-thumbnail" src="{{ values[fieldName] }}" alt="Podgląd {{ field.label|default(fieldName) }}" style="max-height: 120px;">
                                    </a>
                                </div>
                                {% if not isFieldReadOnly %}
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" name="{{ fieldName }}_remove" id="field-{{ fieldName }}-remove" value="1">
                                        <label class="form-check-label" for="field-{{ fieldName }}-remove">Usuń zdjęcie</label>
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% elseif fieldType == 'file' %}
                            {% set normalizedTypes = [] %}
                            {% if field.file_types is defined %}
                                {% set rawTypes = field.file_types %}
                                {% if rawTypes is not iterable %}
                                    {% set rawTypes = rawTypes|split(',') %}
                                {% endif %}
                                {% set typeMap = { 'pdf': ['.pdf'], 'excel': ['.xls', '.xlsx', '.csv'], 'word': ['.doc', '.docx'] } %}
                                {% for rawType in rawTypes %}
                                    {% set key = rawType|lower|trim|replace({'.': ''}) %}
                                    {% if typeMap[key] is defined %}
                                        {% set normalizedTypes = normalizedTypes|merge(typeMap[key]) %}
                                    {% elseif key %}
                                        {% set normalizedTypes = normalizedTypes|merge(['.' ~ key]) %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                            {% set acceptTypes = normalizedTypes|join(',') %}
                            {% if not isFieldReadOnly %}
                                <input class="form-control" type="file" name="{{ fieldName }}"{% if acceptTypes %} accept="{{ acceptTypes }}"{% endif %}>
                            {% endif %}
                            {% if values[fieldName]|default('') %}
                                <div class="mt-2">
                                    <a href="{{ values[fieldName] }}" target="_blank" rel="noopener noreferrer">Pobierz aktualny plik</a>
                                </div>
                                {% if not isFieldReadOnly %}
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" name="{{ fieldName }}_remove" id="field-{{ fieldName }}-remove" value="1">
                                        <label class="form-check-label" for="field-{{ fieldName }}-remove">Usuń plik</label>
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% elseif fieldType == 'video' %}
                            <div class="border rounded p-3" data-video-upload="true" data-field-name="{{ fieldName }}" data-upload-url="/cms/modules/{{ moduleKey|url_encode }}/chunk-upload/{{ fieldName|url_encode }}" data-max-size-mb="{{ field.max_size_mb|default(300) }}">
                                <input class="form-control mb-2" type="file" accept="video/*" data-video-input="true"{% if isFieldReadOnly %} disabled{% endif %}>
                                <input type="hidden" name="{{ fieldName }}" value="{{ values[fieldName]|default('') }}" data-video-hidden-input="true">
                                <div class="progress mb-2 d-none" data-video-progress-wrapper="true" style="height: 20px;">
                                    <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width:0%" data-video-progress-bar="true">0%</div>
                                </div>
                                {% if values[fieldName]|default('') %}
                                    <div class="mb-2" data-video-preview-wrapper="true">
                                        <video controls preload="metadata" style="max-width:100%;" data-video-preview="true" src="{{ values[fieldName] }}"></video>
                                    </div>
                                {% else %}
                                    <div class="mb-2 d-none" data-video-preview-wrapper="true">
                                        <video controls preload="metadata" style="max-width:100%;" data-video-preview="true"></video>
                                    </div>
                                {% endif %}
                                {% if not isFieldReadOnly %}
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="{{ fieldName }}_remove" id="field-{{ fieldName }}-remove" value="1" data-video-remove-checkbox="true">
                                        <label class="form-check-label" for="field-{{ fieldName }}-remove">Usuń wideo</label>
                                    </div>
                                {% endif %}
                                <div class="form-text" data-video-status="true">
                                    {% if values[fieldName]|default('') %}
                                        <a href="{{ values[fieldName] }}" target="_blank" rel="noopener noreferrer">Pobierz aktualny film</a>
                                    {% else %}
                                        Maksymalny rozmiar: {{ field.max_size_mb|default(300) }} MB.
                                    {% endif %}
                                </div>
                            </div>
                        {% elseif fieldType == 'link' %}
                            <input class="form-control" type="url" name="{{ fieldName }}" value="{{ values[fieldName]|default('') }}" placeholder="https://"{% if isFieldReadOnly %} readonly{% endif %}>
                        {% elseif fieldType in ['number', 'integer', 'float', 'decimal'] %}
                            <input
                                class="form-control"
                                type="number"
                                name="{{ fieldName }}"
                                value="{{ values[fieldName]|default('') }}"
                                {% if field.step|default('') %}step="{{ field.step }}"{% elseif fieldType in ['float', 'decimal'] %}step="any"{% else %}step="1"{% endif %}
                                {% if field.min is defined %}min="{{ field.min }}"{% endif %}
                                {% if field.max is defined %}max="{{ field.max }}"{% endif %}
                                inputmode="{{ fieldType in ['float', 'decimal'] ? 'decimal' : 'numeric' }}"
                                {% if isFieldReadOnly %} readonly{% endif %}
                            >
                        {% else %}
                            <input
                                class="form-control"
                                type="text"
                                name="{{ fieldName }}"
                                value="{{ values[fieldName]|default('') }}"
                                {% if field.numeric_only|default(false) %}
                                    inputmode="numeric"
                                    pattern="\d*"
                                {% endif %}
                                {% if isFieldReadOnly %} readonly{% endif %}
                            >
                        {% endif %}
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            {% if hasHeader %}
                </div>
            {% endif %}
            </div>
        {% endfor %}
        {% if not readOnlyMode %}
            {% if showWinnerEmailOption|default(false) %}
                {% include 'backend/_winner_email_option.html.twig' %}
            {% endif %}
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button class="btn btn-primary" type="submit">{{ submitLabel }}</button>
                {% if moduleKey == 'system_settings' %}
                    <button
                        class="btn btn-outline-secondary"
                        type="button"
                        data-test-ftp-settings
                        data-test-ftp-url="/cms/modules/system_settings/test-ftp"
                    >
                        Sprawdź połączenie FTP
                    </button>
                {% endif %}
            </div>
            {% if moduleKey == 'system_settings' %}
                <div class="alert d-none mt-3 mb-0" role="alert" data-test-ftp-result></div>
            {% endif %}
        {% endif %}
    </form>
    {% set editableViewFields = viewEditableFields|default([]) %}
    {% if readOnlyMode and viewActions|default([]) is not empty and editableViewFields is not empty %}
        <form method="post" action="/cms/modules/{{ moduleKey }}/{{ recordId|default(values.id|default('')) }}/extra-action" class="mt-4 pt-3 border-top">
            {% include 'backend/_csrf_token.html.twig' %}
            <h2 class="h5 mb-3">Dane do uzupełnienia</h2>
            {% for field in editableViewFields %}
                {% set fieldName = field.name|default('') %}
                {% set fieldType = field.type|default('text')|lower %}
                {% set fieldLabel = field.label|default(fieldName) %}
                {% set isRequired = field.required|default(false) %}
                {% if fieldName and (field.form is not defined or field.form) and field.readonly|default(false) == false %}
                    <div class="mb-3">
                        <label class="form-label" for="view-field-{{ fieldName }}">
                            {{ fieldLabel }}{% if isRequired %} <span class="text-danger">*</span>{% endif %}
                        </label>
                        {% if fieldType in ['textarea', 'richtext'] %}
                            <textarea
                                class="form-control"
                                name="{{ fieldName }}"
                                id="view-field-{{ fieldName }}"
                                rows="{{ field.rows|default(4) }}"
                                placeholder="{{ field.placeholder|default('') }}"
                                {% if isRequired %}required{% endif %}
                            >{{ values[fieldName]|default('') }}</textarea>
                        {% elseif fieldType == 'select' %}
                            {% set selectedValue = values[fieldName]|default('') %}
                            <select class="form-select" name="{{ fieldName }}" id="view-field-{{ fieldName }}"{% if isRequired %} required{% endif %}>
                                <option value="" {% if selectedValue == '' %}selected{% endif %}></option>
                                {% for optionValue, optionLabel in field.options|default({}) %}
                                    <option value="{{ optionValue }}" {% if optionValue == selectedValue %}selected{% endif %}>{{ optionLabel }}</option>
                                {% endfor %}
                            </select>
                        {% elseif fieldType in ['checkbox', 'boolean'] %}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="{{ fieldName }}" id="view-field-{{ fieldName }}" value="1" {% if values[fieldName]|default(false) %}checked{% endif %}{% if isRequired %} required{% endif %}>
                                <label class="form-check-label" for="view-field-{{ fieldName }}">Tak</label>
                            </div>
                        {% elseif fieldType == 'date' %}
                            <input class="form-control" type="date" name="{{ fieldName }}" id="view-field-{{ fieldName }}" value="{{ values[fieldName]|default('') }}"{% if isRequired %} required{% endif %}>
                        {% elseif fieldType == 'datetime' %}
                            <input class="form-control" type="datetime-local" name="{{ fieldName }}" id="view-field-{{ fieldName }}" value="{{ values[fieldName]|default('')|replace({' ': 'T'}) }}"{% if isRequired %} required{% endif %}>
                        {% else %}
                            <input class="form-control" type="text" name="{{ fieldName }}" id="view-field-{{ fieldName }}" value="{{ values[fieldName]|default('') }}" placeholder="{{ field.placeholder|default('') }}"{% if isRequired %} required{% endif %}>
                        {% endif %}
                        {% if field.help|default('') %}
                            <div class="form-text">{{ field.help }}</div>
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            <div class="d-flex flex-wrap gap-2">
                {% for action in viewActions %}
                    <button class="btn {{ action.class|default('btn-outline-secondary') }}" type="submit" name="action_key" value="{{ action.key }}"{% if action.confirm is defined %} onclick="return confirm('{{ action.confirm|e('js') }}');"{% endif %}>{{ action.label }}</button>
                {% endfor %}
            </div>
        </form>
    {% elseif readOnlyMode and viewActions|default([]) is not empty %}
        <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
            {% for action in viewActions %}
                <form method="post" action="/cms/modules/{{ moduleKey }}/{{ recordId|default(values.id|default('')) }}/extra-action" class="d-inline"{% if action.confirm is defined %} onsubmit="return confirm('{{ action.confirm|e('js') }}');"{% endif %}>
                    {% include 'backend/_csrf_token.html.twig' %}
                    <button class="btn {{ action.class|default('btn-outline-secondary') }}" type="submit" name="action_key" value="{{ action.key }}">{{ action.label }}</button>
                </form>
            {% endfor %}
        </div>
    {% endif %}
</div>
<script>
    const moduleForm = document.querySelector('form[enctype="multipart/form-data"]');
    const moduleFormSubmitButtons = moduleForm ? Array.from(moduleForm.querySelectorAll('button[type="submit"], input[type="submit"]')) : [];
    let activeVideoUploads = 0;

    const ftpTestButton = document.querySelector('[data-test-ftp-settings]');
    const ftpTestResult = document.querySelector('[data-test-ftp-result]');

    if (ftpTestButton && ftpTestResult && moduleForm) {
        ftpTestButton.addEventListener('click', async () => {
            const testUrl = ftpTestButton.getAttribute('data-test-ftp-url') || '';
            if (!testUrl) {
                return;
            }

            ftpTestButton.disabled = true;
            ftpTestResult.className = 'alert alert-info mt-3 mb-0';
            ftpTestResult.textContent = 'Sprawdzanie połączenia FTP...';

            try {
                const response = await fetch(testUrl, {
                    method: 'POST',
                    body: new FormData(moduleForm),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                });
                const payload = await response.json().catch(() => ({}));
                const isSuccess = response.ok && payload.success === true;
                ftpTestResult.className = `alert ${isSuccess ? 'alert-success' : 'alert-danger'} mt-3 mb-0`;
                ftpTestResult.textContent = payload.message || (isSuccess
                    ? 'Połączenie FTP działa poprawnie.'
                    : 'Nie udało się sprawdzić połączenia FTP.');
            } catch (error) {
                ftpTestResult.className = 'alert alert-danger mt-3 mb-0';
                ftpTestResult.textContent = 'Nie udało się wysłać testu połączenia FTP.';
            } finally {
                ftpTestButton.disabled = false;
            }
        });
    }

    const setModuleFormUploadingState = (isUploading) => {
        if (!moduleForm) {
            return;
        }

        activeVideoUploads = Math.max(0, activeVideoUploads + (isUploading ? 1 : -1));
        const shouldDisableSubmit = activeVideoUploads > 0;
        moduleFormSubmitButtons.forEach((button) => {
            button.disabled = shouldDisableSubmit;
        });
    };

    if (moduleForm) {
        moduleForm.addEventListener('submit', (event) => {
            if (activeVideoUploads > 0) {
                event.preventDefault();
                window.alert('Poczekaj na zakończenie wgrywania plików przed zapisaniem formularza.');
            }
        });
    }

    const moduleTabTriggers = document.querySelectorAll('[data-module-tab-trigger]');
    const moduleTabPanels = document.querySelectorAll('[data-module-tab-panel]');

    if (moduleTabTriggers.length && moduleTabPanels.length) {
        const activateModuleTab = (tabKey) => {
            moduleTabTriggers.forEach((trigger) => {
                const isActive = trigger.dataset.moduleTabTrigger === tabKey;
                trigger.classList.toggle('active', isActive);
            });

            moduleTabPanels.forEach((panel) => {
                const isActive = panel.dataset.moduleTabPanel === tabKey;
                panel.classList.toggle('d-none', !isActive);
            });
        };

        moduleTabTriggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
                activateModuleTab(trigger.dataset.moduleTabTrigger || '');
            });
        });
    }

    const relationSearchWrappers = document.querySelectorAll('[data-relation-search="true"]');
    relationSearchWrappers.forEach((wrapper) => {
        const input = wrapper.querySelector('.relation-search-input');
        const results = wrapper.querySelector('.relation-search-results');
        const selected = wrapper.querySelector('.relation-search-selected');
        const searchUrl = wrapper.dataset.searchUrl;
        const fieldName = wrapper.dataset.fieldName;
        const isMultiple = wrapper.dataset.multiple === '1';
        const searchFiltersRaw = wrapper.dataset.searchFilters || '{}';
        const minLength = 1;
        let searchFilters = {};

        try {
            searchFilters = JSON.parse(searchFiltersRaw);
        } catch (error) {
            searchFilters = {};
        }

        if (!input || !results || !selected || !searchUrl || !fieldName) {
            return;
        }

        const getSelectedValues = () => new Set(
            Array.from(selected.querySelectorAll('input[type="hidden"]'))
                .map((inputEl) => inputEl.value)
        );

        const removeSelection = (value) => {
            const chip = selected.querySelector(`[data-value="${value}"]`);
            if (chip) {
                const hidden = chip.nextElementSibling;
                if (hidden && hidden.tagName === 'INPUT') {
                    hidden.remove();
                }
                chip.remove();
            }
        };

        const addSelection = (value, label) => {
            if (!value) {
                return;
            }

            if (!isMultiple) {
                selected.innerHTML = '';
            }

            const existing = getSelectedValues();
            if (existing.has(value)) {
                return;
            }

            const chip = document.createElement('span');
            chip.className = 'badge bg-primary relation-search-chip';
            chip.dataset.value = value;
            chip.textContent = label;

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn-close btn-close-white relation-remove';
            removeButton.setAttribute('aria-label', 'Usuń');

            chip.appendChild(removeButton);

            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = isMultiple ? `${fieldName}[]` : fieldName;
            hidden.value = value;

            selected.appendChild(chip);
            selected.appendChild(hidden);
        };

        const clearResults = () => {
            results.innerHTML = '';
        };

        const renderResults = (items) => {
            clearResults();
            if (!items.length) {
                return;
            }

            const selectedValues = getSelectedValues();

            items.forEach((item) => {
                if (selectedValues.has(item.value)) {
                    return;
                }
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'list-group-item list-group-item-action';
                button.dataset.value = item.value;
                button.dataset.label = item.label;
                button.textContent = item.label;
                results.appendChild(button);
            });
        };

        let debounceTimer;
        input.addEventListener('input', () => {
            const term = input.value.trim();
            clearTimeout(debounceTimer);

            if (term.length < minLength) {
                clearResults();
                return;
            }

            debounceTimer = setTimeout(async () => {
                const url = new URL(searchUrl, window.location.origin);
                url.searchParams.set('q', term);

                Object.keys(searchFilters).forEach((queryParam) => {
                    const sourceField = (searchFilters[queryParam] || '').toString().trim();
                    if (!sourceField) {
                        return;
                    }

                    const hiddenInput = document.querySelector(`input[type="hidden"][name="${sourceField}"]`);
                    let sourceValue = '';
                    if (hiddenInput) {
                        sourceValue = hiddenInput.value.trim();
                    } else {
                        const sourceSelect = document.getElementById(`field-${sourceField}`);
                        if (sourceSelect instanceof HTMLSelectElement) {
                            sourceValue = sourceSelect.value.trim();
                        }
                    }

                    if (sourceValue !== '') {
                        url.searchParams.set(queryParam, sourceValue);
                    }
                });

                try {
                    const response = await fetch(url.toString(), {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                    });
                    if (!response.ok) {
                        clearResults();
                        return;
                    }
                    const payload = await response.json();
                    renderResults(payload.items || []);
                } catch (error) {
                    clearResults();
                }
            }, 250);
        });

        results.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) {
                return;
            }
            if (!target.dataset.value) {
                return;
            }
            addSelection(target.dataset.value, target.dataset.label || target.textContent || target.dataset.value);
            input.value = '';
            clearResults();
        });

        selected.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLElement)) {
                return;
            }
            if (!target.classList.contains('relation-remove')) {
                return;
            }
            const chip = target.closest('.relation-search-chip');
            if (!chip) {
                return;
            }
            removeSelection(chip.dataset.value);
        });
    });


    const linkListEditors = document.querySelectorAll('[data-link-list-editor="true"]');
    linkListEditors.forEach((editor) => {
        const itemsContainer = editor.querySelector('[data-link-list-items="true"]');
        const addButton = editor.querySelector('[data-link-list-add="true"]');
        const template = editor.querySelector('template[data-link-list-template="true"]');
        const hiddenInput = editor.querySelector('[data-link-list-input="true"]');

        if (!itemsContainer || !addButton || !template || !hiddenInput) {
            return;
        }

        const serializeItems = () => {
            const payload = [];
            itemsContainer.querySelectorAll('[data-link-list-item="true"]').forEach((item) => {
                const nameInput = item.querySelector('[data-link-list-name="true"]');
                const fileSelect = item.querySelector('[data-link-list-file="true"]');
                if (!(nameInput instanceof HTMLInputElement) || !(fileSelect instanceof HTMLSelectElement)) {
                    return;
                }

                const name = nameInput.value.trim();
                const fileId = fileSelect.value.trim();
                if (!name || !fileId) {
                    return;
                }

                payload.push({ nazwa: name, file_id: fileId });
            });

            hiddenInput.value = JSON.stringify(payload);
        };

        const attachItemListeners = (item) => {
            const upButton = item.querySelector('[data-link-list-up="true"]');
            const downButton = item.querySelector('[data-link-list-down="true"]');
            const removeButton = item.querySelector('[data-link-list-remove="true"]');
            const nameInput = item.querySelector('[data-link-list-name="true"]');
            const fileSelect = item.querySelector('[data-link-list-file="true"]');

            if (upButton) {
                upButton.addEventListener('click', () => {
                    const previous = item.previousElementSibling;
                    if (previous) {
                        itemsContainer.insertBefore(item, previous);
                        serializeItems();
                    }
                });
            }

            if (downButton) {
                downButton.addEventListener('click', () => {
                    const next = item.nextElementSibling;
                    if (next) {
                        itemsContainer.insertBefore(next, item);
                        serializeItems();
                    }
                });
            }

            if (removeButton) {
                removeButton.addEventListener('click', () => {
                    item.remove();
                    serializeItems();
                });
            }

            if (nameInput) {
                nameInput.addEventListener('input', serializeItems);
            }

            if (fileSelect) {
                fileSelect.addEventListener('change', serializeItems);
            }
        };

        itemsContainer.querySelectorAll('[data-link-list-item="true"]').forEach(attachItemListeners);

        addButton.addEventListener('click', () => {
            const fragment = template.content.cloneNode(true);
            const newItem = fragment.querySelector('[data-link-list-item="true"]');
            if (!(newItem instanceof HTMLElement)) {
                return;
            }

            attachItemListeners(newItem);
            itemsContainer.appendChild(newItem);
            serializeItems();
        });

        serializeItems();
    });

    const structuredListEditors = document.querySelectorAll('[data-structured-list-editor="true"]');
    structuredListEditors.forEach((editor) => {
        const itemsContainer = editor.querySelector('[data-structured-list-items="true"]');
        const addButton = editor.querySelector('[data-structured-list-add="true"]');
        const template = editor.querySelector('template[data-structured-list-template="true"]');
        const hiddenInput = editor.querySelector('[data-structured-list-input="true"]');

        if (!itemsContainer || !addButton || !template || !hiddenInput) {
            return;
        }

        const serializeItems = () => {
            const payload = [];
            itemsContainer.querySelectorAll('[data-structured-list-item="true"]').forEach((item) => {
                const row = {};
                let hasValue = false;
                item.querySelectorAll('[data-structured-list-value]').forEach((input) => {
                    if (!(input instanceof HTMLInputElement)) {
                        return;
                    }
                    const key = input.dataset.structuredListValue || '';
                    if (!key) {
                        return;
                    }
                    const value = input.value.trim();
                    row[key] = value;
                    if (value !== '') {
                        hasValue = true;
                    }
                });

                if (hasValue) {
                    payload.push(row);
                }
            });

            hiddenInput.value = JSON.stringify(payload);
        };

        const attachItemListeners = (item) => {
            const upButton = item.querySelector('[data-structured-list-up="true"]');
            const downButton = item.querySelector('[data-structured-list-down="true"]');
            const removeButton = item.querySelector('[data-structured-list-remove="true"]');

            if (upButton) {
                upButton.addEventListener('click', () => {
                    const previous = item.previousElementSibling;
                    if (previous) {
                        itemsContainer.insertBefore(item, previous);
                        serializeItems();
                    }
                });
            }

            if (downButton) {
                downButton.addEventListener('click', () => {
                    const next = item.nextElementSibling;
                    if (next) {
                        itemsContainer.insertBefore(next, item);
                        serializeItems();
                    }
                });
            }

            if (removeButton) {
                removeButton.addEventListener('click', () => {
                    item.remove();
                    serializeItems();
                });
            }

            item.querySelectorAll('[data-structured-list-value]').forEach((input) => {
                input.addEventListener('input', serializeItems);
                input.addEventListener('change', serializeItems);
            });

            item.querySelectorAll('[data-structured-list-image-input="true"]').forEach((fileInput) => {
                if (!(fileInput instanceof HTMLInputElement)) {
                    return;
                }

                fileInput.addEventListener('change', async () => {
                    const file = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;
                    if (!file) {
                        return;
                    }
                    if (!file.type || !file.type.startsWith('image/')) {
                        window.alert('Wybierz plik graficzny.');
                        fileInput.value = '';
                        return;
                    }

                    const fieldKey = fileInput.dataset.structuredListImageName || '';
                    const hiddenImageInput = fieldKey ? item.querySelector(`[data-structured-list-value="${fieldKey}"]`) : null;
                    const status = fileInput.parentElement ? fileInput.parentElement.querySelector('[data-structured-list-image-status="true"]') : null;
                    const previewWrapper = fileInput.parentElement ? fileInput.parentElement.querySelector('[data-structured-list-image-preview-wrapper="true"]') : null;
                    const previewLink = fileInput.parentElement ? fileInput.parentElement.querySelector('[data-structured-list-image-link="true"]') : null;
                    const preview = fileInput.parentElement ? fileInput.parentElement.querySelector('[data-structured-list-image-preview="true"]') : null;
                    if (!(hiddenImageInput instanceof HTMLInputElement) || !fieldKey) {
                        return;
                    }

                    const uploadUrl = `/cms/modules/{{ moduleKey|url_encode }}/chunk-upload/${encodeURIComponent(hiddenInput.name || 'structured_list')}-${encodeURIComponent(fieldKey)}`;
                    const csrfTokenInput = moduleForm ? moduleForm.querySelector('input[name="_csrf_token"]') : null;
                    const csrfToken = csrfTokenInput instanceof HTMLInputElement ? csrfTokenInput.value : '';
                    const formData = new FormData();
                    if (csrfToken) {
                        formData.append('_csrf_token', csrfToken);
                    }
                    formData.append('uploadId', `${Date.now()}-${Math.random().toString(16).slice(2)}`);
                    formData.append('chunkIndex', '0');
                    formData.append('totalChunks', '1');
                    formData.append('originalName', file.name);
                    formData.append('chunk', file, file.name);

                    setModuleFormUploadingState(true);
                    if (status) {
                        status.textContent = 'Wgrywanie zdjęcia...';
                    }

                    try {
                        const response = await fetch(uploadUrl, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}),
                            },
                        });
                        const payload = await response.json().catch(() => ({}));
                        if (!response.ok || !payload.done || !payload.path) {
                            throw new Error(payload.error || 'Nie udało się wgrać zdjęcia.');
                        }

                        hiddenImageInput.value = payload.path;
                        if (previewWrapper instanceof HTMLElement) {
                            previewWrapper.classList.remove('d-none');
                        }
                        if (previewLink instanceof HTMLAnchorElement) {
                            previewLink.href = payload.path;
                        }
                        if (preview instanceof HTMLImageElement) {
                            preview.src = payload.path;
                        }
                        if (status) {
                            status.textContent = 'Zdjęcie wgrane.';
                        }
                        serializeItems();
                    } catch (error) {
                        if (status) {
                            status.textContent = error instanceof Error ? error.message : 'Nie udało się wgrać zdjęcia.';
                        }
                    } finally {
                        setModuleFormUploadingState(false);
                    }
                });
            });
        };

        itemsContainer.querySelectorAll('[data-structured-list-item="true"]').forEach(attachItemListeners);

        addButton.addEventListener('click', () => {
            const fragment = template.content.cloneNode(true);
            const newItem = fragment.querySelector('[data-structured-list-item="true"]');
            if (!(newItem instanceof HTMLElement)) {
                return;
            }

            attachItemListeners(newItem);
            itemsContainer.appendChild(newItem);
            serializeItems();
        });

        serializeItems();
    });

    const padNumber = (value) => String(value).padStart(2, '0');

    const formatCurrentDate = (date) => `${date.getFullYear()}-${padNumber(date.getMonth() + 1)}-${padNumber(date.getDate())}`;
    const formatCurrentDateTime = (date) => `${formatCurrentDate(date)} ${padNumber(date.getHours())}:${padNumber(date.getMinutes())}:${padNumber(date.getSeconds())}`;

    document.querySelectorAll('button[data-set-current-date="true"]').forEach((button) => {
        button.addEventListener('click', () => {
            const targetId = button.getAttribute('data-target-id');
            if (!targetId) {
                return;
            }

            const target = document.getElementById(targetId);
            if (!(target instanceof HTMLInputElement)) {
                return;
            }

            const now = new Date();
            target.value = formatCurrentDate(now);
            target.dispatchEvent(new Event('input', { bubbles: true }));
            target.dispatchEvent(new Event('change', { bubbles: true }));
        });
    });

    document.querySelectorAll('button[data-set-current-datetime="true"]').forEach((button) => {
        button.addEventListener('click', () => {
            const targetId = button.getAttribute('data-target-id');
            if (!targetId) {
                return;
            }

            const target = document.getElementById(targetId);
            if (!(target instanceof HTMLInputElement)) {
                return;
            }

            const now = new Date();
            if (target._flatpickr && typeof target._flatpickr.setDate === 'function') {
                target._flatpickr.setDate(now, true);
            } else {
                target.value = formatCurrentDateTime(now);
                target.dispatchEvent(new Event('input', { bubbles: true }));
                target.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    });
</script>
